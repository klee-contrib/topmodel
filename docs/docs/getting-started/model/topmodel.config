# yaml-language-server: $schema=./topmodel.config.schema.json
app: Hello World
modelRoot: ./
jpa:
  - tags: [back]
    outputDirectory: ./output/java
    apiGeneration: Server
csharp:
  - tags: [back]
    outputDirectory: ./output/csharp
    apiGeneration: Server
sql:
  - tags: [back]
    outputDirectory: ./output/sql
    procedural: {}
javascript:
  - tags: [front]
    outputDirectory: ./output/javascript
    apiMode: angular
    apiClientRootPath: api
    modelRootPath: model
