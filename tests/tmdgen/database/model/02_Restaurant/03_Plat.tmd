####
#### ATTENTION CE FICHIER EST GENERE AUTOMATIQUEMENT !
####

---
module: Restaurant
tags:
  - Back
uses:
  - 02_Restaurant/01_Lieu
---
class:
  name: LigneCommandeHistorique
  sqlName: ligne_commande_historique
  comment: Ligne de commande pour historique avec préservation des clés primaires
  properties:
    - name: LigId
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant de la ligne

    - name: LigQuantite
      domain: DO_ENTIER
      required: true
      comment: Quantité commandée

    - name: LigPrixUnitaire
      domain: DO_ENTIER
      required: true
      comment: Prix unitaire au moment de la commande

    - name: LigPrixTotal
      domain: DO_ENTIER
      required: true
      comment: Prix total de la ligne

    - name: PlaId
      domain: DO_ID
      required: true
      comment: Plat commandé

    - name: LigDateCreation
      domain: DO_DATE_TIME
      required: true
      comment: Date de création de l'enregistrement

    - association: CommandeHistorique
      comment: Commande à laquelle appartient la ligne
      required: true
---
class:
  name: Menu
  sqlName: menu
  comment: Menu du restaurant
  trigram: MEN
  properties:
    - name: Id
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant du menu

    - name: Nom
      domain: DO_LIBELLE
      required: true
      comment: Nom du menu

    - name: Description
      domain: DO_LIBELLE
      comment: Description du menu

    - name: Prix
      domain: DO_ENTIER
      required: true
      comment: Prix du menu

    - name: Disponible
      domain: DO_BOOLEAN
      required: true
      comment: Indique si le menu est disponible

    - name: DateDebut
      domain: DO_DATE_TIME
      comment: Date de début de validité du menu

    - name: DateFin
      domain: DO_DATE_TIME
      comment: Date de fin de validité du menu

    - association: Lieu
      comment: Restaurant proposant ce menu
      required: true

    - name: DateCreation
      domain: DO_DATE_TIME
      required: true
      comment: Date de création de l'enregistrement
---
class:
  name: Plat
  sqlName: plat
  comment: Plat du menu
  properties:
    - name: PlaId
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant du plat

    - name: PlaNom
      domain: DO_LIBELLE
      required: true
      comment: Nom du plat

    - name: PlaDescription
      domain: DO_LIBELLE
      comment: Description du plat

    - name: PlaPrix
      domain: DO_ENTIER
      required: true
      comment: Prix du plat

    - name: PlaDisponible
      domain: DO_BOOLEAN
      required: true
      comment: Indique si le plat est disponible

    - association: CategoriePlat
      comment: Catégorie du plat
      required: true

    - association: Lieu
      comment: Restaurant proposant ce plat
      required: true

    - name: PlaDateCreation
      domain: DO_DATE_TIME
      required: true
      comment: Date de création de l'enregistrement

    - name: PboVolume
      domain: DO_ENTIER
      comment: Volume de la boisson

    - name: PprVegetarien
      domain: DO_BOOLEAN
      comment: Si le plat est végétarien.
---
class:
  name: Table
  sqlName: table
  comment: Table du restaurant
  trigram: TAB
  properties:
    - name: Id
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant de la table

    - name: Numero
      domain: DO_LIBELLE
      required: true
      comment: Numéro de la table

    - name: Capacite
      domain: DO_ENTIER
      required: true
      comment: Capacité de la table (nombre de places)

    - name: Disponible
      domain: DO_BOOLEAN
      required: true
      comment: Indique si la table est disponible

    - association: Lieu
      comment: Restaurant auquel appartient la table
      required: true

    - name: DateCreation
      domain: DO_DATE_TIME
      required: true
      comment: Date de création de l'enregistrement

  unique:
    - [LieuLieId, Numero]
