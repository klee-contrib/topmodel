---
module: Restaurant
tags:
  - Back
---
class:
  name: Assiette
  sqlName: assiette
  comment: Assiette.
  properties:
    - name: VslId
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Id de la vaisselle

    - name: VslDescription
      domain: DO_LIBELLE
      required: true
      comment: Description de la vaisselle.

    - name: AstTaille
      domain: DO_ENTIER
      required: true
      comment: Taille de l'assiette.
---
class:
  name: CategoriePlat
  sqlName: categorie_plat
  comment: Catégorie de plat
  trigram: CAT
  properties:
    - name: Code
      domain: DO_LIBELLE
      required: true
      primaryKey: true
      comment: Code de la catégorie

    - name: Libelle
      domain: DO_LIBELLE
      required: true
      comment: Libellé de la catégorie

    - name: Ordre
      domain: DO_ENTIER
      required: true
      comment: Ordre d'affichage dans le menu.

    - name: PrixMoyen
      domain: DO_ENTIER
      comment: Prix moyen de la catégorie, à titre indicatif.

  unique:
    - [Ordre]
---
class:
  name: CommandeHistorique
  sqlName: commande_historique
  comment: Commande pour historique avec préservation des clés primaires
  properties:
    - name: ComId
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant de la commande

    - name: ComDateCommande
      domain: DO_DATE_TIME
      required: true
      comment: Date et heure de la commande

    - name: ComDateLivraison
      domain: DO_DATE_TIME
      comment: Date et heure de livraison

    - name: ComMontantTotal
      domain: DO_ENTIER
      required: true
      comment: Montant total de la commande

    - name: PerId
      domain: DO_ID
      required: true
      comment: Client ayant passé la commande

    - name: TabId
      domain: DO_ID
      comment: Table associée à la commande

    - name: RevId
      domain: DO_ID
      comment: Réservation associée à la commande

    - name: StcCode
      domain: DO_CODE
      required: true
      comment: Statut de la commande

    - name: AviId
      domain: DO_ID
      comment: Avis laissé par le client sur la commande.

    - name: ComDateCreation
      domain: DO_DATE_TIME
      required: true
      comment: Date de création de l'enregistrement
---
class:
  name: Couvert
  sqlName: couvert
  comment: Couvert.
  trigram: VSL
  properties:
    - name: Id
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Id de la vaisselle

    - name: Description
      domain: DO_LIBELLE
      required: true
      comment: Description de la vaisselle.
---
class:
  name: Lieu
  sqlName: lieu
  comment: Lieu
  properties:
    - name: LieId
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant du restaurant

    - name: LieNom
      domain: DO_LIBELLE
      required: true
      comment: Nom du restaurant

    - name: LieAdresse
      domain: DO_LIBELLE
      comment: Adresse du restaurant

    - name: LieDiscriminator
      domain: DO_LIBELLE
      required: true
      comment: Discriminateur pour les instances de la hiérarchie de classe

    - name: ResTelephone
      domain: DO_LIBELLE
      comment: Numéro de téléphone

    - name: ResDateCreation
      domain: DO_DATE_TIME
      comment: Date de création de l'enregistrement

    - name: FrnTelephone
      domain: DO_LIBELLE
      comment: Numéro de téléphone

    - name: FrnBio
      domain: DO_BOOLEAN
      comment: Si le fournisseur fait du bio.
---
class:
  name: Prestataire
  sqlName: prestataire
  comment: Prestaire du restaurant
  trigram: PST
  properties:
    - name: Id
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant de la personne

    - name: Nom
      domain: DO_LIBELLE
      required: true
      comment: Nom de la personne

    - name: Prenom
      domain: DO_LIBELLE
      required: true
      comment: Prénom de la personne

    - name: Telephone
      domain: DO_LIBELLE
      comment: Numéro de téléphone de l'employé.
---
class:
  name: Verre
  sqlName: verre
  comment: Verre.
  properties:
    - name: VslId
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Id de la vaisselle

    - name: VslDescription
      domain: DO_LIBELLE
      required: true
      comment: Description de la vaisselle.

    - name: VrrAPied
      domain: DO_BOOLEAN
      required: true
      comment: Si le verre est à pied ou non.
