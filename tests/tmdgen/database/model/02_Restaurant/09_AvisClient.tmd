####
#### ATTENTION CE FICHIER EST GENERE AUTOMATIQUEMENT !
####

---
module: Restaurant
tags:
  - Back
uses:
  - 02_Restaurant/01_Lieu
  - 02_Restaurant/07_Client
---
class:
  name: AvisClient
  sqlName: avis_client
  comment: Avis d'un client sur un restaurant
  trigram: AVI
  properties:
    - name: Id
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant de l'avis

    - name: Note
      domain: DO_ENTIER
      required: true
      comment: Note sur 5

    - name: Commentaire
      domain: DO_LIBELLE
      comment: Commentaire de l'avis

    - name: DateAvis
      domain: DO_DATE_TIME
      required: true
      comment: Date de l'avis

    - name: Approuve
      domain: DO_BOOLEAN
      required: true
      comment: Indique si l'avis est approuvé par le restaurant

    - association: Client
      comment: Client ayant donné l'avis
      required: true

    - association: Lieu
      comment: Restaurant concerné par l'avis
      required: true

    - name: DateCreation
      domain: DO_DATE_TIME
      required: true
      comment: Date de création de l'enregistrement

  unique:
    - [ClientPersonneId, LieuLieId, DateAvis]
