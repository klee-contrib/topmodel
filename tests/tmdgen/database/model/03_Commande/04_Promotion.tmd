---
module: Commande
tags:
  - Back
uses:
  - 03_Commande/01_Restaurant
  - 03_Commande/02_Plat
---
class:
  name: Promotion
  sqlName: promotion
  comment: Promotion sur un plat
  trigram: PRO
  properties:
    - association: Plat
      comment: Plat concerné par la promotion.
      required: true
      primaryKey: true

    - name: Libelle
      domain: DO_LIBELLE
      required: true
      comment: Libellé de la promotion

    - name: PourcentageReduction
      domain: DO_ENTIER
      required: true
      comment: Pourcentage de réduction (0-100)

    - name: DateDebut
      domain: DO_DATE_TIME
      required: true
      comment: Date de début de la promotion

    - name: DateFin
      domain: DO_DATE_TIME
      required: true
      comment: Date de fin de la promotion

    - name: Active
      domain: DO_BOOLEAN
      required: true
      comment: Indique si la promotion est active

    - association: Restaurant
      comment: Restaurant concerné par la promotion (null si globale)

    - name: DateCreation
      domain: DO_DATE_TIME
      required: true
      comment: Date de création de l'enregistrement
