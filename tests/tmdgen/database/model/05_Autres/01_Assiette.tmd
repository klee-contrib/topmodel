  properties:
    - name: Id
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Id de la vaisselle

    - name: Description
      domain: DO_LIBELLE
      required: true
      comment: Description de la vaisselle.
---
class:
  name: Prestataire
  sqlName: prestataire
  comment: Prestaire du restaurant
  trigram: PST
  properties:
    - name: Id
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant de la personne

    - name: Nom
      domain: DO_LIBELLE
      required: true
      comment: Nom de la personne

    - name: Prenom
      domain: DO_LIBELLE
      required: true
      comment: Prénom de la personne

    - name: Telephone
      domain: DO_LIBELLE
      comment: Numéro de téléphone de l'employé.
---
class:
  name: Verre
  sqlName: verre
  comment: Verre.
  properties:
    - name: VslId
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Id de la vaisselle

    - name: VslDescription
      domain: DO_LIBELLE
      required: true
      comment: Description de la vaisselle.

    - name: VrrAPied
