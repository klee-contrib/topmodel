      domain: DO_ID
      required: true
      primaryKey: true
      comment: Id de la vaisselle

    - name: VslDescription
      domain: DO_LIBELLE
      required: true
      comment: Description de la vaisselle.

    - name: AstTaille
      domain: DO_ENTIER
      required: true
      comment: Taille de l'assiette.
---
class:
  name: Couvert
  sqlName: couvert
