---
module: Restaurant
tags:
  - Back
---
class:
  name: CategoriePlat
  sqlName: categorie_plat
  comment: Catégorie de plat
  trigram: CAT
  properties:
    - name: Code
      domain: DO_LIBELLE
      required: true
      primaryKey: true
      comment: Code de la catégorie

    - name: Libelle
      domain: DO_LIBELLE
      required: true
      comment: Libellé de la catégorie

    - name: Ordre
      domain: DO_ENTIER
      required: true
      comment: Ordre d'affichage dans le menu.

    - name: PrixMoyen
      domain: DO_ENTIER
      comment: Prix moyen de la catégorie, à titre indicatif.

  unique:
    - [Ordre]
---
class:
  name: CommandeHistorique
  sqlName: commande_historique
  comment: Commande pour historique avec préservation des clés primaires
  properties:
    - name: ComId
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant de la commande

    - name: ComDateCommande
      domain: DO_DATE_TIME
      required: true
      comment: Date et heure de la commande

    - name: ComDateLivraison
      domain: DO_DATE_TIME
      comment: Date et heure de livraison

    - name: ComMontantTotal
      domain: DO_ENTIER
      required: true
      comment: Montant total de la commande

    - name: PerId
      domain: DO_ID
      required: true
      comment: Client ayant passé la commande

    - name: TabId
      domain: DO_ID
      comment: Table associée à la commande

    - name: RevId
      domain: DO_ID
      comment: Réservation associée à la commande

    - name: StcCode
      domain: DO_LIBELLE
      required: true
      comment: Statut de la commande

    - name: AviId
      domain: DO_ID
      comment: Avis laissé par le client sur la commande.

    - name: ComDateCreation
      domain: DO_DATE_TIME
      required: true
      comment: Date de création de l'enregistrement
---
class:
  name: Restaurant
  sqlName: restaurant
  comment: Restaurant
  trigram: RES
  properties:
    - name: Id
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant du restaurant

    - name: Nom
      domain: DO_LIBELLE
      required: true
      comment: Nom du restaurant

    - name: Adresse
      domain: DO_LIBELLE
      comment: Adresse du restaurant

    - name: Telephone
      domain: DO_LIBELLE
      comment: Numéro de téléphone

    - name: DateCreation
      domain: DO_DATE_TIME
      required: true
      comment: Date de création de l'enregistrement
---
class:
  name: StatutCommande
  sqlName: statut_commande
  comment: Statut d'une commande
  trigram: STC
  properties:
    - name: Code
      domain: DO_LIBELLE
      required: true
      primaryKey: true
      comment: Code du statut

    - name: Libelle
      domain: DO_LIBELLE
      required: true
      comment: Libellé du statut
---
class:
  name: TypeTerrasse
  sqlName: type_terrasse
  comment: Type de terrasse
  properties:
    - name: Code
      domain: DO_LIBELLE
      required: true
      primaryKey: true
      comment: Code du type de terrase
