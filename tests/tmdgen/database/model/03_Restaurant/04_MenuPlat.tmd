---
module: Restaurant
tags:
  - Back
uses:
  - 03_Restaurant/02_Plat
---
class:
  name: MenuPlat
  sqlName: menu_plat
  comment: Plat dans un menu
  trigram: MPL
  properties:
    - association: Menu
      comment: Menu contenant ce plat
      required: true
      primaryKey: true

    - association: Plat
      comment: Plat du menu
      required: true
      primaryKey: true

    - name: Ordre
      domain: DO_ENTIER
      required: true
      comment: Ordre d'affichage du plat dans le menu

    - name: DateCreation
      domain: DO_DATE_TIME
      required: true
      comment: Date de création de l'enregistrement

  unique:
    - [MenuId, Ordre]
