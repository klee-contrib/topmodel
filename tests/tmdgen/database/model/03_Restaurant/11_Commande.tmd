####
#### ATTENTION CE FICHIER EST GENERE AUTOMATIQUEMENT !
####

---
module: Restaurant
tags:
  - Back
uses:
  - 03_Restaurant/02_Plat
  - 03_Restaurant/07_Client
  - 03_Restaurant/09_AvisClient
  - 03_Restaurant/10_Reservation
---
class:
  name: Commande
  sqlName: commande
  comment: Commande d'un client
  properties:
    - name: ComId
      domain: DO_ID
      required: true
      primaryKey: true
      comment: Identifiant de la commande

    - name: ComDateCommande
      domain: DO_DATE_TIME
      required: true
      comment: Date et heure de la commande

    - name: ComDateLivraison
      domain: DO_DATE_TIME
      comment: Date et heure de livraison

    - name: ComMontantTotal
      domain: DO_ENTIER
      required: true
      comment: Montant total de la commande

    - association: Client
      comment: Client ayant passé la commande
      required: true

    - association: TableRestaurant
      comment: Table associée à la commande

    - association: Reservation
      comment: Réservation associée à la commande

    - name: StcCode
      domain: DO_LIBELLE
      required: true
      comment: Statut de la commande

    - association: AvisClient
      comment: Avis laissé par le client sur la commande.

    - name: ComDateCreation
      domain: DO_DATE_TIME
      required: true
      comment: Date de création de l'enregistrement

  unique:
    - [AvisClientId]
