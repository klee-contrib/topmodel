---
module: Common
tags:
  - back
  - front

---
# Annotation pour les propriétés sensibles
annotation:
  name: Sensible
  description: Marque une propriété comme contenant des données sensibles
  target:
    - property
  java:
    - text: "@Sensitive"
      imports:
        - com.example.annotations.Sensitive

  csharp:
    - text: "[Sensitive]"
      imports:
        - System.ComponentModel.DataAnnotations
---
# Annotation pour les propriétés calculées
annotation:
  name: Calcule
  description: Marque une propriété comme étant calculée
  target:
    - property
    - regular-property

  java:
    - text: "@Calculated"
      imports:
        - com.example.annotations.Calculated

  csharp:
    - text: "[Calculated]"
      imports:
        - System.ComponentModel.DataAnnotations
---
# Annotation pour les clés primaires "techniques", qui ne doit pas se poser sur les clés étrangères
annotation:
  name: IdentifiantTechnique
  description: Marque une propriété comme étant l'identifiant technique de sa classe
  target:
    - property
  java:
    - text: "@ReadOnlyProperty"
      imports:
        - org.springframework.data.annotation.ReadOnlyProperty
      when:
        - primary-key

  csharp:
    - text: Editable(false)
      imports:
        - System.ComponentModel.DataAnnotations
      when:
        - primary-key
---
# Annotation pour les endpoints nécessitant une authentification
annotation:
  name: Authenticated
  description: Marque un endpoint comme nécessitant une authentification
  target:
    - server-endpoint

  java:
    - text: '@PreAuthorize("isAuthenticated()")'
      imports:
        - org.springframework.security.access.prepost.PreAuthorize

  csharp:
    - text: "Authorize"
      imports:
        - Microsoft.AspNetCore.Authorization
---
# Annotation pour les endpoints nécessitant un rôle spécifique
annotation:
  name: RoleRequired
  description: Marque un endpoint comme nécessitant un rôle spécifique
  target:
    - server-endpoint
  parameters:
    - name: role
      comment: Nom du rôle requis
      required: true

  java:
    - text: 'PreAuthorize("hasRole(''{role}'')")'
      imports:
        - org.springframework.security.access.prepost.PreAuthorize

  csharp:
    - text: 'Authorize(Roles = "{role}")'
      imports:
        - Microsoft.AspNetCore.Authorization
