---
module: Common
tags: []

---
domain:
  name: DO_ID
  label: Identifiant
  autoGeneratedValue: true
  asDomains:
    list: DO_LISTE
  ts:
    type: number
  csharp:
    type: int
  java:
    type: Integer
  sql:
    type: int
---
domain:
  name: DO_LIBELLE
  label: Libellé
  asDomains:
    list: DO_LISTE
  length: 100
  ts:
    type: string
  csharp:
    type: string
  java:
    type: String
  sql:
    type: varchar
---
domain:
  name: DO_PRIX
  label: Prix
  asDomains:
    list: DO_LISTE
  scale: 2
  ts:
    type: number
  csharp:
    type: decimal
  java:
    type: BigDecimal
    imports:
      - java.math.BigDecimal
    values:
      template: new BigDecimal({value})
  sql:
    type: decimal
---
domain:
  name: DO_QUANTITE
  label: Quantité
  asDomains:
    list: DO_LISTE
  ts:
    type: number
  csharp:
    type: int
  java:
    type: Integer
  sql:
    type: int
---
domain:
  name: DO_DATE_HEURE
  label: Date et heure
  asDomains:
    list: DO_LISTE
  ts:
    type: string
  csharp:
    type: DateTime
    values:
      template: DateTime.Parse("{value}")
  java:
    type: LocalDateTime
    imports:
      - java.time.LocalDateTime
  sql:
    type: timestamp
---
domain:
  name: DO_TELEPHONE
  label: Téléphone
  asDomains:
    list: DO_LISTE
  length: 20
  ts:
    type: string
  csharp:
    type: string
  java:
    type: String
  sql:
    type: varchar
---
domain:
  name: DO_CODE
  label: Code
  asDomains:
    list: DO_LISTE
  length: 10
  ts:
    type: string
  csharp:
    type: string
  java:
    type: String
  sql:
    type: varchar
---
domain:
  name: DO_BOOLEEN
  label: Booléen
  asDomains:
    list: DO_LISTE
  ts:
    type: boolean
  csharp:
    type: bool
  java:
    type: Boolean
  sql:
    type: boolean
---
domain:
  name: DO_LISTE
  asDomains:
    list: DO_LISTE
  label: Liste pour composition
  collection: true
  csharp:
    genericType: ICollection<{T}>
    collector: ToList()
  java:
    genericType: List<{T}>
    imports:
      - java.util.List
  ts:
    genericType: "{T}[]"
  sql:
    genericType: jsonb
---
domain:
  name: DO_FICHIER
  label: Fichier
  mediaType: application/octet-stream
  ts:
    type: Blob
  csharp:
    type: byte[]
  java:
    type: byte[]
  sql:
    type: blob
---
converter:
  from:
    - DO_ID
  to:
    - DO_LIBELLE
  java:
    text: "{value}.toString()"
