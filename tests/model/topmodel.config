# yaml-language-server: $schema=./topmodel.config.schema.json
---
app: Restaurant
generators:
  - ../../TopModel.Generator.Csharp
  - ../../TopModel.Generator.Javascript
  - ../../TopModel.Generator.Jpa
  - ../../TopModel.Generator.Sql
  - ../../TopModel.Generator.Translation

javascript:
  - name: angular
    tags: &front
      - front
    outputDirectory: ../output/angular/src/appgenerated
    apiClientRootPath: api
    modelRootPath: model
    domainPath: "@/domains"
    resourceRootPath: resources
    entityMode: focus
    apiMode: angular
    referenceMode: values
    resourceMode: json

sql:
  - name: pg
    tags:
      - back
    outputDirectory: ../output/pg/src
    targetDBMS: postgre
    procedural:
      crebasFile: 01_tables.sql
      indexFKFile: 02_fk_indexes.sql
      uniqueKeysFile: 03_unique_keys.sql
      initListFile: 04_references.sql
      commentFile: 05_comments.sql
      resourceFile: 06_resources.sql
      identity:
        increment: 50
        start: 1000
        mode: sequence
    translateProperties: true
    translateReferences: true
    language: [sql2, sql]

  - name: ssdt
    tags:
      - back
    outputDirectory: ../output/ssdt/src
    targetDBMS: sqlserver
    ignoreDefaultValues: false
    ssdt:
      tableScriptFolder: tables
      tableTypeScriptFolder: types
      initListScriptFolder: init
      initListMainScriptName: main.sql
      generateComments: true

csharp:
  - tags: &back
      - back
      - api-client
    variables:
      app: TopModel.Sample
      clientsDb: Clients:TopModel.Sample.Clients.Db
    tagVariables:
      back:
        apiGeneration: Server
        apiRootPath: "{app}.Api"
      api-client:
        apiGeneration: Client
        apiRootPath: Clients:{app}.Clients.External
    outputDirectory: ../output/csharp/src
    dbContextPath: "{clientsDb}"
    mappersName: "{module:tail}Mappers"
    persistentModelPath: "{clientsDb}/Models/{module:path}"
    referencesModelPath: Models:{app}.{module:head}.Models/{module:tail:path}
    nonPersistentModelPath: Models:{app}.{module:head}.Models/{module:tail:path}
    referenceAccessorsInterfacePath: "{clientsDb}/Reference"
    apiRootPath: "{apiRootPath}"
    apiGeneration: "{apiGeneration}"
    useEFComments: true
    useCancellationTokens: true
    resourcesResxPath: Models/{app}.{module:head}.Models
    resourcesInResx: properties
translation:
  - tags:
      - front
      - back
    outputDirectory: ../output/translation
    rootPath: i18n/{lang}/out
    langs:
      - en_US
      - de_DE
jpa:
  - &jpa-base-config
    tags: *back
    variables:
      confName: jpa-sequence-metamodel
    name: jpa-sequence-metamodel
    outputDirectory: ../output/jpa/src/main
    entitiesPath: "javagen:{app:path}/{confName}/entities/{module:path}"
    dtosPath: "javagen:{app:path}/{confName}/dtos/{module:path}"
    daosPath: "javagen:{app:path}/{confName}/daos/{module:path}"
    enumsPath: "javagen:{app:path}/{confName}/enums/{module:path}"
    apiPath: "javagen:{app:path}/{confName}/api/server/{module:path}"
    apiGeneration: Server
    resourcesPath: "resources/{confName}/i18n/model"
    fieldsEnum:
      - persisted
      - non-persisted
    daosInterface: topmodel.test.CustomCrudRepository
    mappersInClass: true
    useJdbc: false
    enumsAsEnums: false
    openApiAnnotations: true
    metaModel: true
    associationAdders: true
    associationRemovers: true
    identity:
      mode: sequence
      increment: 50
      start: 1000
  - <<: *jpa-base-config
    name: jpa-identity-enums
    variables:
      confName: jpa-identity-enums
    apiGeneration: Client
    clientApiGeneration: FeignClient
    mappersInClass: true
    enumsAsEnums: true
    identity:
      mode: identity
  - <<: *jpa-base-config
    name: jpa-uuid-jdbc
    variables:
      confName: jpa-uuid-jdbc
    apiGeneration: Server
    fieldsEnum:
      - non-persisted
    daosAbstract: false
    mappersInClass: false
    useJdbc: true
    enumsAsEnums: false
    openApiAnnotations: false
    identity:
      mode: uuid
  - <<: *jpa-base-config
    name: jpa-identity-associations
    variables:
      confName: jpa-identity-associations
    apiGeneration: Client
    clientApiGeneration: RestTemplate
    mappersInClass: true
    useJdbc: false
    enumsAsEnums: false
    openApiAnnotations: false
    metaModel: true
    identity:
      mode: identity
    associationAdders: true
    associationRemovers: true
