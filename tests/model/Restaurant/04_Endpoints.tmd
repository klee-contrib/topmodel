---
module: Restaurant
tags:
  - front
  - back
  - api-client
uses:
  - Restaurant/02_Entities
  - Restaurant/03_Dtos
  - Restaurant/01_References
options:
  endpoints:
    prefix: api/restaurants

---
# Endpoints pour les Restaurants

endpoint:
  name: GetRestaurants
  method: GET
  route: /
  description: Liste tous les restaurants

  returns:
    composition: RestaurantItem
    name: restaurants
    domain: DO_LISTE
    comment: Liste des restaurants

---
endpoint:
  name: GetRestaurant
  method: GET
  route: /{resId}
  description: Charge le détail d'un restaurant

  params:
    - alias:
        class: Restaurant
        property: Id

  returns:
    composition: RestaurantRead
    name: restaurant
    comment: Détail du restaurant
---
endpoint:
  name: AddRestaurant
  method: POST
  route: /
  description: Ajoute un restaurant

  params:
    - composition: RestaurantWrite
      comment: Restaurant à créer
      name: restaurant

  returns:
    composition: RestaurantRead
    name: restaurant
    comment: Restaurant créé
---
endpoint:
  name: UpdateRestaurant
  method: PUT
  route: /{resId}
  description: Met à jour un restaurant

  params:
    - alias:
        class: Restaurant
        property: Id
    - composition: RestaurantWrite
      comment: Restaurant à mettre à jour
      name: restaurant

  returns:
    composition: RestaurantRead
    name: restaurant
    comment: Restaurant mis à jour
---
endpoint:
  name: DeleteRestaurant
  method: DELETE
  route: /{resId}
  description: Supprime un restaurant

  params:
    - alias:
        class: Restaurant
        property: Id
---
# Endpoints pour les Clients

endpoint:
  name: GetClients
  method: GET
  route: /clients
  description: Liste tous les clients

  params:
    - alias:
        class: Client
        property: Nom
    - alias:
        class: Client
        property: Email

  returns:
    composition: ClientItem
    name: clients
    domain: DO_LISTE
    comment: Liste des clients

---
endpoint:
  name: GetClient
  method: GET
  route: /clients/{cliId}
  description: Charge le détail d'un client

  params:
    - alias:
        class: Client
        property: Id

  returns:
    composition: ClientRead
    name: client
    comment: Détail du client
---
endpoint:
  name: AddClient
  method: POST
  route: /clients
  description: Ajoute un client

  params:
    - composition: ClientWrite
      comment: Client à créer
      name: client

  returns:
    composition: ClientRead
    name: client
    comment: Client créé
---
endpoint:
  name: UpdateClient
  method: PUT
  route: /clients/{cliId}
  description: Met à jour un client

  params:
    - alias:
        class: Client
        property: Id
    - composition: ClientWrite
      comment: Client à mettre à jour
      name: client

  returns:
    composition: ClientRead
    name: client
    comment: Client mis à jour
---
endpoint:
  name: PatchClient
  method: PATCH
  route: /clients/{cliId}
  description: Met à jour partiellement un client

  params:
    - alias:
        class: Client
        property: Id
    - composition: ClientWrite
      comment: Données partielles du client
      name: client

  returns:
    composition: ClientRead
    name: client
    comment: Client mis à jour
---
endpoint:
  name: DeleteClient
  method: DELETE
  route: /clients/{cliId}
  description: Supprime un client

  params:
    - alias:
        class: Client
        property: Id
---
endpoint:
  name: GetClientCommandes
  method: GET
  route: /clients/{cliId}/commandes
  description: Liste les commandes d'un client

  params:
    - alias:
        class: Client
        property: Id

  returns:
    composition: CommandeItem
    name: commandes
    domain: DO_LISTE
    comment: Liste des commandes du client
---
# Endpoints pour les Plats

endpoint:
  name: GetPlats
  method: GET
  route: /plats
  description: Liste tous les plats

  params:
    - alias:
        class: Plat
        property: Disponible
    - alias:
        class: Plat
        property: RestaurantIdRestaurant
    - alias:
        class: Plat
        property: CategoriePlatCodeCategoriePlat

  returns:
    composition: PlatItem
    name: plats
    domain: DO_LISTE
    comment: Liste des plats

---
endpoint:
  name: GetPlat
  method: GET
  route: /plats/{plaId}
  description: Charge le détail d'un plat

  params:
    - alias:
        class: Plat
        property: Id

  returns:
    composition: PlatRead
    name: plat
    comment: Détail du plat
---
endpoint:
  name: AddPlat
  method: POST
  route: /plats
  description: Ajoute un plat

  params:
    - composition: PlatWrite
      comment: Plat à créer
      name: plat

  returns:
    composition: PlatRead
    name: plat
    comment: Plat créé
---
endpoint:
  name: UpdatePlat
  method: PUT
  route: /plats/{plaId}
  description: Met à jour un plat

  params:
    - alias:
        class: Plat
        property: Id
    - composition: PlatWrite
      comment: Plat à mettre à jour
      name: plat

  returns:
    composition: PlatRead
    name: plat
    comment: Plat mis à jour
---
endpoint:
  name: PatchPlat
  method: PATCH
  route: /plats/{plaId}
  description: Met à jour partiellement un plat

  params:
    - alias:
        class: Plat
        property: Id
    - composition: PlatWrite
      comment: Données partielles du plat
      name: plat

  returns:
    composition: PlatRead
    name: plat
    comment: Plat mis à jour
---
endpoint:
  name: DeletePlat
  method: DELETE
  route: /plats/{plaId}
  description: Supprime un plat

  params:
    - alias:
        class: Plat
        property: Id
---
endpoint:
  name: GetRestaurantPlats
  method: GET
  route: /{resId}/plats
  description: Liste les plats d'un restaurant

  params:
    - alias:
        class: Restaurant
        property: Id
    - alias:
        class: Plat
        property: Disponible
    - alias:
        class: Plat
        property: CategoriePlatCodeCategoriePlat

  returns:
    composition: PlatItem
    name: plats
    domain: DO_LISTE
    comment: Liste des plats du restaurant
---
# Endpoints pour les Tables

endpoint:
  name: GetTables
  method: GET
  route: /tables
  description: Liste toutes les tables

  params:
    - alias:
        class: TableClient
        property: RestaurantIdRestaurant
    - alias:
        class: TableClient
        property: Disponible

  returns:
    composition: TableClientItem
    name: tables
    domain: DO_LISTE
    comment: Liste des tables

---
endpoint:
  name: GetTable
  method: GET
  route: /tables/{tabId}
  description: Charge le détail d'une table

  params:
    - alias:
        class: TableClient
        property: Id

  returns:
    composition: TableClientRead
    name: table
    comment: Détail de la table
---
endpoint:
  name: AddTable
  method: POST
  route: /tables
  description: Ajoute une table

  params:
    - composition: TableClientWrite
      comment: Table à créer
      name: table

  returns:
    composition: TableClientRead
    name: table
    comment: Table créée
---
endpoint:
  name: UpdateTable
  method: PUT
  route: /tables/{tabId}
  description: Met à jour une table

  params:
    - alias:
        class: TableClient
        property: Id
    - composition: TableClientWrite
      comment: Table à mettre à jour
      name: table

  returns:
    composition: TableClientRead
    name: table
    comment: Table mise à jour
---
endpoint:
  name: DeleteTable
  method: DELETE
  route: /tables/{tabId}
  description: Supprime une table

  params:
    - alias:
        class: TableClient
        property: Id
---
endpoint:
  name: GetRestaurantTables
  method: GET
  route: /{resId}/tables
  description: Liste les tables d'un restaurant

  params:
    - alias:
        class: Restaurant
        property: Id
    - alias:
        class: TableClient
        property: Disponible

  returns:
    composition: TableClientItem
    name: tables
    domain: DO_LISTE
    comment: Liste des tables du restaurant
---
# Endpoints pour les Commandes

endpoint:
  name: GetCommandes
  method: GET
  route: /commandes
  description: Liste toutes les commandes

  params:
    - alias:
        class: Commande
        property: ClientId
    - alias:
        class: Commande
        property: StatutCommandeCode
    - alias:
        class: Commande
        property: TableClientId

  returns:
    composition: CommandeItem
    name: commandes
    domain: DO_LISTE
    comment: Liste des commandes

---
endpoint:
  name: GetCommande
  method: GET
  route: /commandes/{comId}
  description: Charge le détail d'une commande

  params:
    - alias:
        class: Commande
        property: Id

  returns:
    composition: CommandeRead
    name: commande
    comment: Détail de la commande
---
endpoint:
  name: AddCommande
  method: POST
  route: /commandes
  description: Crée une nouvelle commande

  params:
    - composition: CommandeWrite
      comment: Commande à créer
      name: commande

  returns:
    composition: CommandeRead
    name: commande
    comment: Commande créée
---
endpoint:
  name: UpdateCommande
  method: PUT
  route: /commandes/{comId}
  description: Met à jour une commande

  params:
    - alias:
        class: Commande
        property: Id
    - composition: CommandeWrite
      comment: Commande à mettre à jour
      name: commande

  returns:
    composition: CommandeRead
    name: commande
    comment: Commande mise à jour
---
endpoint:
  name: PatchCommande
  method: PATCH
  route: /commandes/{comId}
  description: Met à jour partiellement une commande

  params:
    - alias:
        class: Commande
        property: Id
    - composition: CommandeWrite
      comment: Données partielles de la commande
      name: commande

  returns:
    composition: CommandeRead
    name: commande
    comment: Commande mise à jour
---
endpoint:
  name: DeleteCommande
  method: DELETE
  route: /commandes/{comId}
  description: Supprime une commande

  params:
    - alias:
        class: Commande
        property: Id
---
endpoint:
  name: UpdateCommandeStatut
  method: PATCH
  route: /commandes/{comId}/statut
  description: Met à jour uniquement le statut d'une commande

  params:
    - alias:
        class: Commande
        property: Id
    - alias:
        class: Commande
        property: StatutCommandeCode

  returns:
    composition: CommandeRead
    name: commande
    comment: Commande avec le statut mis à jour
---
# Endpoints pour les Lignes de Commande

endpoint:
  name: GetLigneCommandes
  method: GET
  route: /ligne-commandes
  description: Liste toutes les lignes de commande

  params:
    - alias:
        class: LigneCommande
        property: CommandeId
    - alias:
        class: LigneCommande
        property: PlatId

  returns:
    composition: LigneCommandeItem
    name: ligneCommandes
    domain: DO_LISTE
    comment: Liste des lignes de commande

---
endpoint:
  name: GetLigneCommande
  method: GET
  route: /ligne-commandes/{ligId}
  description: Charge le détail d'une ligne de commande

  params:
    - alias:
        class: LigneCommande
        property: Id

  returns:
    composition: LigneCommandeRead
    name: ligneCommande
    comment: Détail de la ligne de commande
---
endpoint:
  name: AddLigneCommande
  method: POST
  route: /ligne-commandes
  description: Ajoute une ligne de commande

  params:
    - composition: LigneCommandeWrite
      comment: Ligne de commande à créer
      name: ligneCommande

  returns:
    composition: LigneCommandeRead
    name: ligneCommande
    comment: Ligne de commande créée
---
endpoint:
  name: UpdateLigneCommande
  method: PUT
  route: /ligne-commandes/{ligId}
  description: Met à jour une ligne de commande

  params:
    - alias:
        class: LigneCommande
        property: Id
    - composition: LigneCommandeWrite
      comment: Ligne de commande à mettre à jour
      name: ligneCommande

  returns:
    composition: LigneCommandeRead
    name: ligneCommande
    comment: Ligne de commande mise à jour
---
endpoint:
  name: DeleteLigneCommande
  method: DELETE
  route: /ligne-commandes/{ligId}
  description: Supprime une ligne de commande

  params:
    - alias:
        class: LigneCommande
        property: Id
---
endpoint:
  name: GetCommandeLignes
  method: GET
  route: /commandes/{comId}/lignes
  description: Liste les lignes d'une commande

  params:
    - alias:
        class: Commande
        property: Id

  returns:
    composition: LigneCommandeItem
    name: lignes
    domain: DO_LISTE
    comment: Liste des lignes de la commande
---
# Endpoints pour les Références

endpoint:
  name: GetStatutCommandes
  method: GET
  route: /statuts-commande
  description: Liste tous les statuts de commande

  returns:
    composition: StatutCommande
    name: statuts
    domain: DO_LISTE
    comment: Liste des statuts de commande

---
endpoint:
  name: GetCategoriePlats
  method: GET
  route: /categorie-plats
  description: Liste toutes les catégories de plats

  returns:
    composition: CategoriePlat
    name: categories
    domain: DO_LISTE
    comment: Liste des catégories de plats
---
# Endpoints de recherche et statistiques

endpoint:
  name: SearchPlats
  method: GET
  route: /plats/search
  description: Recherche de plats avec critères multiples

  params:
    - alias:
        class: Plat
        property: Nom
    - alias:
        class: Plat
        property: RestaurantIdRestaurant
    - alias:
        class: Plat
        property: CategoriePlatCodeCategoriePlat
    - alias:
        class: Plat
        property: Disponible

  returns:
    composition: PlatItem
    name: plats
    domain: DO_LISTE
    comment: Plats correspondant aux critères de recherche

---
endpoint:
  name: GetCommandesByDate
  method: GET
  route: /commandes/by-date
  description: Récupère les commandes par date

  params:
    - alias:
        class: Commande
        property: DateCommande

  returns:
    composition: CommandeItem
    name: commandes
    domain: DO_LISTE
    comment: Commandes pour la date spécifiée
