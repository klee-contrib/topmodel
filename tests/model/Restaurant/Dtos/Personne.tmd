---
module: Restaurant
tags:
  - front
  - back
uses:
  - Restaurant/Entities/Commande
  - Restaurant/Entities/Personne

---
class:
  name: EmployeItem
  abstract: true
  comment: Détail d'un employé en liste

  properties:
    - name: Id
      domain: DO_ID
      comment: Identifiant de l'employé
    - name: Nom
      domain: DO_LIBELLE
      comment: Nom de l'employé
    - name: Prenom
      domain: DO_LIBELLE
      comment: Prénom de l'employé
    - alias:
        class: Employe
        include:
          - Matricule
          - Restaurant
---
class:
  name: EmployeRead
  comment: Détail d'un employé en lecture

  properties:
    - alias:
        class: Personne
      defaultValue: null
    - alias:
        class: Employe

  mappers:
    from:
      - params:
          - class: Employe
---
class:
  name: EmployeWrite
  comment: Détail d'un employé en écriture

  properties:
    - alias:
        class: Personne
        exclude:
          - Id
          - DateCreation
    - alias:
        class: Employe

  mappers:
    to:
      - class: Employe
---
class:
  name: ClientItem
  comment: Détail d'un client en liste
  properties:
    - alias:
        class: Personne
        include:
          - Id
          - Nom
          - Prenom
      label: Informations client
    - name: NomComplet
      domain: DO_LIBELLE
      readonly: true
      comment: Nom complet du client (calculé)

  mappers:
    from:
      - params:
          - class: Client
---
class:
  name: ClientRead
  comment: Détail d'un client en lecture

  properties:
    - alias:
        class: Personne
      defaultValue: null
    - alias:
        class: Client

  mappers:
    from:
      - params:
          - class: Client
---
class:
  name: ClientWrite
  comment: Détail d'un client en écriture

  properties:
    - alias:
        class: Personne
        exclude:
          - Id
          - DateCreation
    - alias:
        class: Client

  mappers:
    to:
      - class: Client
---
class:
  name: ClientAvecCommandes
  comment: Client avec la liste de ses commandes

  properties:
    - alias:
        class: Personne
      defaultValue: null
    - alias:
        class: Client
    - alias:
        class: Commande
      prefix: true
      as: list
      comment: Liste des commandes du client
---
class:
  name: AvisClientRead
  comment: Détail d'un avis en lecture

  properties:
    - alias:
        class: AvisClient

  mappers:
    from:
      - params:
          - class: AvisClient
---
class:
  name: AvisClientWrite
  comment: Détail d'un avis en écriture

  properties:
    - alias:
        class: AvisClient
        exclude:
          - Id
          - DateAvis
          - NombreVues
          - DateCreation

  mappers:
    to:
      - class: AvisClient
