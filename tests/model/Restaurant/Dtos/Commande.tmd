---
module: Restaurant
tags:
  - front
  - back
uses:
  - Restaurant/Endpoints/Commande
  - Restaurant/Entities/Commande
  - Restaurant/Entities/Personne
  - Restaurant/Entities/Restaurant
---
class:
  name: CommandeItem
  abstract: true
  comment: Détail d'une commande en liste

  properties:
    - alias:
        class: Commande
        include:
          - Id
          - DateCommande
          - MontantTotal
          - StatutCommandeCode
          - ClientId
---
class:
  name: CommandeRead
  comment: Détail d'une commande en lecture

  properties:
    - alias:
        class: Commande
        exclude: Lignes

    - alias:
        class: Commande
        include: Lignes
      composition: LigneCommandeRead

  mappers:
    from:
      - params:
          - class: Commande
---
class:
  name: CommandeWrite
  comment: Détail d'une commande en écriture

  properties:
    - alias:
        class: CommandeRead
        exclude:
          - Id
          - Lignes
    - alias:
        class: CommandeRead
        property: Lignes
      composition: LigneCommandeWrite

  mappers:
    to:
      - class: Commande
---
class:
  name: CommandeResume
  abstract: true
  comment: Résumé d'une commande pour liste

  properties:
    - alias:
        endpoint: GetCommande
        include: Id
---
class:
  name: LigneCommandeRead
  comment: Détail d'une ligne de commande en lecture

  properties:
    - alias:
        class: LigneCommande

  mappers:
    from:
      - params:
          - class: LigneCommande
---
class:
  name: LigneCommandeWrite
  comment: Détail d'une ligne de commande en écriture

  properties:
    - alias:
        class: LigneCommande
        exclude:
          - Id

  mappers:
    to:
      - class: LigneCommande
---
class:
  name: ReservationRead
  comment: Détail d'une réservation en lecture

  properties:
    - alias:
        class: Reservation
    - alias:
        class: Personne
        include:
          - Nom
          - Prenom
      prefix: Client
      comment: Informations du client ayant fait la réservation
    - alias:
        class: Client
        include: Email
      prefix: true
      comment: Informations du client ayant fait la réservation

    - alias:
        class: TableRestaurant
        include:
          - Numero
          - Capacite
      prefix: Table
      comment: Table réservée

  mappers:
    from:
      - params:
          - class: Reservation
---
class:
  name: ReservationWrite
  comment: Détail d'une réservation en écriture

  properties:
    - alias:
        class: Reservation
        exclude:
          - Id

  mappers:
    to:
      - class: Reservation
