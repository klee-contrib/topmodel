---
module: Restaurant
tags:
  - front
  - back
uses:
  - Restaurant/Dtos/Personne
  - Restaurant/Endpoints/Commande
  - Restaurant/Entities/Commande
  - Restaurant/Entities/Personne
  - Restaurant/Entities/Restaurant
---
class:
  name: CommandeItem
  abstract: true
  comment: Détail d'une commande en liste

  properties:
    - alias:
        class: Commande
        include:
          - Id
          - DateCommande
          - MontantTotal
          - StatutCommande
          - Client
---
class:
  name: CommandeRead
  comment: Détail d'une commande en lecture

  properties:
    - alias:
        class: Commande
        exclude:
          - Client
          - Lignes
          - Reservation

    - alias:
        class: Commande
        property: Client
      composition: ClientRead
      name: Client

    - composition: ReservationRead
      name: Reservation
      required: false
      comment: Réservation.

    - alias:
        class: Commande
        include: Lignes
      composition: LigneCommandeRead

  mappers:
    from:
      - params:
          - class: Commande
---
class:
  name: CommandeWrite
  comment: Détail d'une commande en écriture

  properties:
    - alias:
        class: Commande
        exclude:
          - Id
          - Client
          - Reservation
          - Lignes

    - alias:
        class: CommandeRead
        property: Client
      composition: ClientWrite

    - alias:
        class: CommandeRead
        property: Reservation
      composition: ReservationWrite

    - alias:
        class: CommandeRead
        property: Lignes
      composition: LigneCommandeWrite

  mappers:
    to:
      - class: Commande
---
class:
  name: CommandeResume
  abstract: true
  comment: Résumé d'une commande pour liste

  properties:
    - alias:
        endpoint: GetCommande
        include: Id
      readonly: true
---
class:
  name: LigneCommandeRead
  comment: Détail d'une ligne de commande en lecture

  properties:
    - alias:
        class: LigneCommande

  mappers:
    from:
      - params:
          - class: LigneCommande
---
class:
  name: LigneCommandeWrite
  comment: Détail d'une ligne de commande en écriture

  properties:
    - alias:
        class: LigneCommande
        exclude:
          - Id

  mappers:
    to:
      - class: LigneCommande
---
class:
  name: ReservationRead
  comment: Détail d'une réservation en lecture

  properties:
    - alias:
        class: Reservation
    - alias:
        class: Personne
        include:
          - Nom
          - Prenom
      prefix: Client
      comment: Informations du client ayant fait la réservation
    - alias:
        class: Client
        include: Email
      prefix: true
      comment: Informations du client ayant fait la réservation

    - alias:
        class: TableRestaurant
        include:
          - Numero
          - Capacite
      prefix: Table
      comment: Table réservée

  mappers:
    from:
      - params:
          - class: Reservation
---
class:
  name: ReservationWrite
  comment: Détail d'une réservation en écriture

  properties:
    - alias:
        class: Reservation
        exclude:
          - Id

  mappers:
    to:
      - class: Reservation
