---
module: Restaurant
tags:
  - front
  - back
uses:
  - Restaurant/Entities/Menu
---
class:
  name: MenuRead
  comment: Détail d'un menu en lecture

  properties:
    - alias:
        class: Menu
        exclude: Plats

    - composition: PlatItem
      name: Plats
      domain: DO_LISTE
      required: true
      comment: Liste des plats du menu

  mappers:
    from:
      - params:
          - class: Menu
---
class:
  name: MenuWrite
  comment: Détail d'un menu en écriture

  properties:
    - alias:
        class: Menu
        exclude:
          - Id
          - Plats

  mappers:
    to:
      - class: Menu
---
class:
  name: PlatItem
  abstract: true
  comment: Détail d'un plat en liste

  properties:
    - alias:
        class: Plat
        include:
          - Id
          - Nom
          - Prix
          - Disponible
          - CategoriePlat

  mappers:
    from:
      - params:
          - class: Plat

    to:
      - class: Plat
---
class:
  name: PlatItemReadonly
  abstract: true
  comment: Détail d'un plat en liste

  properties:
    - alias:
        class: Plat
        include:
          - Id
          - Nom
          - CategoriePlat
      readonly: true

    - alias:
        class: Plat
        include:
          - Prix
          - Disponible

  mappers:
    from:
      - params:
          - class: PlatItem

    to:
      - class: PlatItem
---
class:
  name: PlatRead
  comment: Détail d'un plat en lecture

  properties:
    - alias:
        class: Plat

  mappers:
    from:
      - params:
          - class: Plat
---
class:
  name: PlatWrite
  comment: Détail d'un plat en écriture

  properties:
    - alias:
        class: Plat
        exclude:
          - Id
  mappers:
    to:
      - class: Plat
---
class:
  name: PromotionRead
  comment: Détail d'une promotion en lecture

  properties:
    - alias:
        class: Promotion

  mappers:
    from:
      - params:
          - class: Promotion
---
class:
  name: PromotionWrite
  comment: Détail d'une promotion en écriture

  properties:
    - alias:
        class: Promotion
        exclude:
          - Plat

  mappers:
    to:
      - class: Promotion
