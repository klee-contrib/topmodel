---
module: Restaurant
tags:
  - front
  - back
uses:
  - Restaurant/02_Entities
  - Restaurant/05_AdvancedEntities

---
# DTOs pour Employe
class:
  name: EmployeItem
  abstract: true
  comment: Détail d'un employé en liste

  properties:
    - alias:
        class: Employe
        include:
          - Matricule
          - RestaurantIdRestaurant
    # Note: Les propriétés héritées (Id, Nom, Prenom) sont accessibles via Employe qui étend Personne
    - name: Id
      domain: DO_ID
      comment: Identifiant de l'employé
    - name: Nom
      domain: DO_LIBELLE
      comment: Nom de l'employé
    - name: Prenom
      domain: DO_LIBELLE
      comment: Prénom de l'employé

---
class:
  name: EmployeRead
  comment: Détail d'un employé en lecture

  properties:
    - alias:
        class: Employe

  mappers:
    from:
      - params:
          - class: Employe

---
class:
  name: EmployeWrite
  comment: Détail d'un employé en écriture

  properties:
    - alias:
        class: Employe
    # Note: Id sera géré automatiquement par le mapper

  mappers:
    to:
      - class: Employe

---
# DTOs pour AvisClient
class:
  name: AvisClientItem
  abstract: true
  comment: Détail d'un avis en liste

  properties:
    - alias:
        class: AvisClient
        include:
          - Id
          - Note
          - DateAvis
          - Approuve
          - ClientIdClient
          - RestaurantIdRestaurant

---
class:
  name: AvisClientRead
  comment: Détail d'un avis en lecture

  properties:
    - alias:
        class: AvisClient

  mappers:
    from:
      - params:
          - class: AvisClient

---
class:
  name: AvisClientWrite
  comment: Détail d'un avis en écriture

  properties:
    - alias:
        class: AvisClient
        exclude:
          - Id
          - DateAvis
          - NombreVues

  mappers:
    to:
      - class: AvisClient

---
# DTOs pour Menu
class:
  name: MenuItem
  abstract: true
  comment: Détail d'un menu en liste

  properties:
    - alias:
        class: Menu
        include:
          - Id
          - Nom
          - Prix
          - Disponible
          - RestaurantIdRestaurant

---
class:
  name: MenuRead
  comment: Détail d'un menu en lecture

  properties:
    - alias:
        class: Menu

  mappers:
    from:
      - params:
          - class: Menu

---
class:
  name: MenuWrite
  comment: Détail d'un menu en écriture

  properties:
    - alias:
        class: Menu
        exclude:
          - Id

  mappers:
    to:
      - class: Menu

---
# DTOs pour Reservation
class:
  name: ReservationItem
  abstract: true
  comment: Détail d'une réservation en liste

  properties:
    - alias:
        class: Reservation
        include:
          - Id
          - DateReservation
          - NombrePersonnes
          - Confirmee
          - ClientIdClient
          - RestaurantIdRestaurant

---
class:
  name: ReservationRead
  comment: Détail d'une réservation en lecture

  properties:
    - alias:
        class: Reservation

  mappers:
    from:
      - params:
          - class: Reservation

---
class:
  name: ReservationWrite
  comment: Détail d'une réservation en écriture

  properties:
    - alias:
        class: Reservation
        exclude:
          - Id

  mappers:
    to:
      - class: Reservation

---
# DTOs pour Promotion
class:
  name: PromotionItem
  abstract: true
  comment: Détail d'une promotion en liste

  properties:
    - alias:
        class: Promotion
        include:
          - Id
          - Libelle
          - PourcentageReduction
          - DateDebut
          - DateFin
          - Active
          - RestaurantIdRestaurant

---
class:
  name: PromotionRead
  comment: Détail d'une promotion en lecture

  properties:
    - alias:
        class: Promotion

  mappers:
    from:
      - params:
          - class: Promotion

---
class:
  name: PromotionWrite
  comment: Détail d'une promotion en écriture

  properties:
    - alias:
        class: Promotion
        exclude:
          - Id

  mappers:
    to:
      - class: Promotion

---
# DTO simple sans décorateurs (les décorateurs seraient appliqués sur les entités)
class:
  name: CommandeAuditee
  comment: Commande avec informations d'audit

  properties:
    - alias:
        class: Commande

---
# DTO simple sans décorateurs
class:
  name: RestaurantVersionne
  comment: Restaurant avec version pour optimistic locking

  properties:
    - alias:
        class: Restaurant

