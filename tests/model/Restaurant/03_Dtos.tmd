---
module: Restaurant
tags:
  - front
  - back
uses:
  - Restaurant/02_Entities

---
class:
  name: PlatItem
  abstract: true
  comment: Détail d'un plat en liste

  properties:
    - alias:
        class: Plat
        include:
          - Id
          - Nom
          - Prix
          - Disponible
          - CategoriePlatCodeCategoriePlat
---
class:
  name: PlatRead
  comment: Détail d'un plat en lecture

  properties:
    - alias:
        class: Plat

  mappers:
    from:
      - params:
          - class: Plat
---
class:
  name: PlatWrite
  comment: Détail d'un plat en écriture

  properties:
    - alias:
        class: Plat
        exclude:
          - Id

  mappers:
    to:
      - class: Plat
---
class:
  name: CommandeItem
  abstract: true
  comment: Détail d'une commande en liste

  properties:
    - alias:
        class: Commande
        include:
          - Id
          - DateCommande
          - MontantTotal
          - StatutCommandeCode
          - ClientId
---
class:
  name: CommandeRead
  comment: Détail d'une commande en lecture

  properties:
    - alias:
        class: Commande

  mappers:
    from:
      - params:
          - class: Commande
---
class:
  name: CommandeWrite
  comment: Détail d'une commande en écriture

  properties:
    - alias:
        class: Commande
        exclude:
          - Id
          - DateCommande
          - MontantTotal

  mappers:
    to:
      - class: Commande
---
class:
  name: ClientItem
  abstract: true
  comment: Détail d'un client en liste

  properties:
    - alias:
        class: Client
        include:
          - Id
          - Nom
          - Prenom
          - Email
---
class:
  name: ClientRead
  comment: Détail d'un client en lecture

  properties:
    - alias:
        class: Client

  mappers:
    from:
      - params:
          - class: Client
---
class:
  name: ClientWrite
  comment: Détail d'un client en écriture

  properties:
    - alias:
        class: Client
        exclude:
          - Id

  mappers:
    to:
      - class: Client
---
class:
  name: RestaurantItem
  abstract: true
  comment: Détail d'un restaurant en liste

  properties:
    - alias:
        class: Restaurant
        include:
          - Id
          - Nom
          - Adresse
          - Telephone
---
class:
  name: RestaurantRead
  comment: Détail d'un restaurant en lecture

  properties:
    - alias:
        class: Restaurant

  mappers:
    from:
      - params:
          - class: Restaurant
---
class:
  name: RestaurantWrite
  comment: Détail d'un restaurant en écriture

  properties:
    - alias:
        class: Restaurant
        exclude:
          - Id

  mappers:
    to:
      - class: Restaurant
---
class:
  name: TableClientItem
  abstract: true
  comment: Détail d'une table en liste

  properties:
    - alias:
        class: TableClient
        include:
          - Id
          - Numero
          - Capacite
          - Disponible
          - RestaurantIdRestaurant
---
class:
  name: TableClientRead
  comment: Détail d'une table en lecture

