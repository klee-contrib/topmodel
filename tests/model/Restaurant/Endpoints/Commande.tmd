---
module: Restaurant
tags:
  - front
  - back
  - api-client
uses:
  - meta/annotations
  - Restaurant/Dtos/Commande
  - Restaurant/Entities/Commande
  - Restaurant/References
options:
  endpoints:
    prefix: api/restaurants
---
endpoint:
  name: GetCommande
  method: GET
  route: /commandes/{comId}
  description: Charge le détail d'une commande

  params:
    - alias:
        class: Commande
        property: Id

  returns:
    composition: CommandeRead
    name: commande
    comment: Détail de la commande
---
endpoint:
  name: GetCommandes
  method: GET
  route: /commandes
  description: Liste toutes les commandes

  params:
    - alias:
        class: Commande
        property: ClientId
    - alias:
        class: Commande
        property: StatutCommandeCode
    - alias:
        class: Commande
        property: TableId

  returns:
    composition: CommandeItem
    name: commandes
    domain: DO_LISTE
    comment: Liste des commandes
---
endpoint:
  name: AddCommande
  method: POST
  route: /commandes
  description: Crée une nouvelle commande

  params:
    - composition: CommandeWrite
      comment: Commande à créer
      name: commande

  returns:
    composition: CommandeRead
    name: commande
    comment: Commande créée
---
endpoint:
  name: UpdateCommande
  method: PUT
  route: /commandes/{comId}
  description: Met à jour une commande

  params:
    - alias:
        class: Commande
        property: Id
    - composition: CommandeWrite
      comment: Commande à mettre à jour
      name: commande

  returns:
    composition: CommandeRead
    name: commande
    comment: Commande mise à jour
---
endpoint:
  name: PatchCommande
  method: PATCH
  route: /commandes/{comId}
  description: Met à jour partiellement une commande

  params:
    - alias:
        class: Commande
        property: Id
    - composition: CommandeWrite
      comment: Données partielles de la commande
      name: commande

  returns:
    composition: CommandeRead
    name: commande
    comment: Commande mise à jour
---
endpoint:
  name: DeleteCommande
  method: DELETE
  route: /commandes/{comId}
  description: Supprime une commande

  params:
    - alias:
        class: Commande
        property: Id
---
endpoint:
  name: UpdateCommandeStatut
  method: PATCH
  route: /commandes/{comId}/statut
  description: Met à jour uniquement le statut d'une commande

  params:
    - alias:
        class: Commande
        property: Id
    - alias:
        class: Commande
        property: StatutCommandeCode

  returns:
    composition: CommandeRead
    name: commande
    comment: Commande avec le statut mis à jour
---
endpoint:
  name: GetLigneCommandes
  method: GET
  route: /ligne-commandes
  description: Liste toutes les lignes de commande

  params:
    - alias:
        class: LigneCommande
        property: CommandeId
    - alias:
        class: LigneCommande
        property: PlatId

  returns:
    composition: LigneCommandeItem
    name: ligneCommandes
    domain: DO_LISTE
    comment: Liste des lignes de commande
---
endpoint:
  name: GetLigneCommande
  method: GET
  route: /ligne-commandes/{ligId}
  description: Charge le détail d'une ligne de commande

  params:
    - alias:
        class: LigneCommande
        property: Id

  returns:
    composition: LigneCommandeRead
    name: ligneCommande
    comment: Détail de la ligne de commande
---
endpoint:
  name: AddLigneCommande
  method: POST
  route: /ligne-commandes
  description: Ajoute une ligne de commande

  params:
    - composition: LigneCommandeWrite
      comment: Ligne de commande à créer
      name: ligneCommande

  returns:
    composition: LigneCommandeRead
    name: ligneCommande
    comment: Ligne de commande créée
---
endpoint:
  name: UpdateLigneCommande
  method: PUT
  route: /ligne-commandes/{ligId}
  description: Met à jour une ligne de commande

  params:
    - alias:
        class: LigneCommande
        property: Id
    - composition: LigneCommandeWrite
      comment: Ligne de commande à mettre à jour
      name: ligneCommande

  returns:
    composition: LigneCommandeRead
    name: ligneCommande
    comment: Ligne de commande mise à jour
---
endpoint:
  name: DeleteLigneCommande
  method: DELETE
  route: /ligne-commandes/{ligId}
  description: Supprime une ligne de commande

  params:
    - alias:
        class: LigneCommande
        property: Id
---
endpoint:
  name: GetCommandeLignes
  method: GET
  route: /commandes/{comId}/lignes
  description: Liste les lignes d'une commande

  params:
    - alias:
        class: Commande
        property: Id

  returns:
    composition: LigneCommandeItem
    name: lignes
    domain: DO_LISTE
    comment: Liste des lignes de la commande
---
endpoint:
  name: GetStatutCommandes
  method: GET
  route: /statuts-commande
  description: Liste tous les statuts de commande

  returns:
    composition: StatutCommande
    name: statuts
    domain: DO_LISTE
    comment: Liste des statuts de commande
---
endpoint:
  name: GetCommandesByDate
  method: GET
  route: /commandes/by-date
  description: Récupère les commandes par date

  params:
    - alias:
        class: Commande
        property: DateCommande

  returns:
    composition: CommandeItem
    name: commandes
    domain: DO_LISTE
    comment: Commandes pour la date spécifiée
---
endpoint:
  name: GetCommandeDetail
  method: GET
  route: /commandes/{comId}/detail
  description: Récupère le détail complet d'une commande avec ses lignes

  params:
    - alias:
        class: Commande
        property: Id

  returns:
    composition: CommandeDetailRead
    name: commande
    comment: Détail complet de la commande
---
endpoint:
  name: ExportCommandes
  method: GET
  route: /commandes/export
  description: Exporte les commandes au format CSV

  annotations:
    - Authenticated
    - RoleRequired:
        role: ADMIN

  params:
    - alias:
        class: Commande
        property: DateCommande
      name: dateDebut
    - alias:
        class: Commande
        property: DateCommande
      name: dateFin

  returns:
    name: fichier
    domain: DO_FICHIER
    comment: Fichier CSV des commandes
---
endpoint:
  name: CreateReservation
  method: POST
  route: /reservations
  description: Crée une réservation

  params:
    - composition: ReservationWrite
      comment: Réservation à créer
      name: reservation

  returns:
    composition: ReservationAvecDetails
    name: reservation
    comment: Réservation créée
