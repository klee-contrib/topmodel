---
module: Restaurant
tags:
  - front
  - back
  - api-client
uses:
  - Restaurant/02_Entities
  - Restaurant/05_AdvancedEntities
  - meta/annotations
  - Restaurant/07_AdvancedDtos
  - Restaurant/10_AdditionalDtos
options:
  endpoints:
    prefix: api/restaurants

---
endpoint:
  name: AddEmploye
  method: POST
  route: /employes
  description: Ajoute un employé (nécessite le rôle ADMIN)

  annotations:
    - Authenticated
    - RoleRequired:
        role: ADMIN

  params:
    - composition: EmployeWrite
      comment: Employé à créer
      name: employe

  returns:
    composition: EmployeRead
    name: employe
    comment: Employé créé
---
endpoint:
  name: GetRestaurantStatistiques
  method: GET
  route: /{resId}/statistiques
  description: Récupère les statistiques d'un restaurant

  annotations:
    - Authenticated

  params:
    - alias:
        class: Restaurant
        property: Id
    - alias:
        class: Commande
        property: DateCommande
      name: dateDebut
      comment: Date de début pour le calcul des statistiques
    - alias:
        class: Commande
        property: DateCommande
      name: dateFin
      comment: Date de fin pour le calcul des statistiques

  returns:
    composition: StatistiquesRestaurant
    name: statistiques
    comment: Statistiques du restaurant
---
endpoint:
  name: GetCommandeDetail
  method: GET
  route: /commandes/{comId}/detail
  description: Récupère le détail complet d'une commande avec ses lignes

  params:
    - alias:
        class: Commande
        property: Id

  returns:
    composition: CommandeDetailRead
    name: commande
    comment: Détail complet de la commande
---
endpoint:
  name: CreateMenu
  method: POST
  route: /menus
  description: Crée un menu avec ses plats

  annotations:
    - Authenticated
    - RoleRequired:
        role: MANAGER

  params:
    - composition: MenuWrite
      comment: Menu à créer
      name: menu

  returns:
    composition: MenuComplet
    name: menu
    comment: Menu créé avec ses plats
---
endpoint:
  name: GetClientAvecCommandes
  method: GET
  route: /clients/{cliId}/avec-commandes
  description: Récupère un client avec toutes ses commandes

  params:
    - alias:
        class: Client
        property: Id

  returns:
    composition: ClientAvecCommandes
    name: client
    comment: Client avec ses commandes
---
endpoint:
  name: SearchRestaurants
  method: GET
  route: /search
  description: Recherche avancée de restaurants

  params:
    - alias:
        class: Restaurant
        property: Nom
      name: nom
      comment: Nom du restaurant (recherche partielle)
    - alias:
        class: Restaurant
        property: Adresse
      name: adresse
      comment: Adresse du restaurant (recherche partielle)
    - alias:
        class: AvisClient
        property: Note
      name: noteMin
      comment: Note minimum requise

  returns:
    composition: RestaurantAvecStatistiques
    name: restaurants
    domain: DO_LISTE
    comment: Liste des restaurants correspondant aux critères
---
endpoint:
  name: PatchPromotion
  method: PATCH
  route: /promotions/{proId}
  description: Met à jour partiellement une promotion

  annotations:
    - Authenticated

  params:
    - alias:
        class: Promotion
        property: Id
    - composition: PromotionWrite
      comment: Données partielles de la promotion
      name: promotion

  returns:
    composition: PromotionRead
    name: promotion
    comment: Promotion mise à jour
---
endpoint:
  name: ExportCommandes
  method: GET
  route: /commandes/export
  description: Exporte les commandes au format CSV

  annotations:
    - Authenticated
    - RoleRequired:
        role: ADMIN

  params:
    - alias:
        class: Commande
        property: DateCommande
      name: dateDebut
    - alias:
        class: Commande
        property: DateCommande
      name: dateFin

  returns:
    name: fichier
    domain: DO_FICHIER
    comment: Fichier CSV des commandes
---
endpoint:
  name: CreateReservation
  method: POST
  route: /reservations
  description: Crée une réservation

  params:
    - composition: ReservationWrite
      comment: Réservation à créer
      name: reservation

  returns:
    composition: ReservationAvecDetails
    name: reservation
    comment: Réservation créée
---
endpoint:
  name: GetRestaurantMenu
  method: GET
  route: /{resId}/menus/{menId}
  description: Récupère un menu spécifique d'un restaurant

  params:
    - alias:
        class: Restaurant
        property: Id
    - alias:
        class: Menu
        property: Id

  returns:
    composition: MenuComplet
    name: menu
    comment: Menu du restaurant
---
endpoint:
  name: GetAvisClients
  method: GET
  route: /avis
  description: Liste les avis clients avec filtres

  params:
    - alias:
        class: Restaurant
        property: Id
      name: restaurantId
    - alias:
        class: AvisClient
        property: Note
      name: noteMin
    - alias:
        class: AvisClient
        property: Approuve
      name: approuve
    - alias:
        class: AvisClient
        property: DateAvis
      name: dateDebut
    - alias:
        class: AvisClient
        property: DateAvis
      name: dateFin

  returns:
    composition: AvisClientRead
    name: avis
    domain: DO_LISTE
    comment: Liste des avis correspondant aux critères
