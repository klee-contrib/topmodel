---
module: Restaurant
tags:
  - back
uses:
  - meta/domain
  - Restaurant/02_Entities

---
# Classe de base avec héritage (exemple conceptuel)
# Note: TopModel supporte l'héritage mais les propriétés doivent être redéfinies
class:
  name: Personne
  trigram: PER
  comment: Classe de base représentant une personne

  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant de la personne

    - name: Nom
      domain: DO_LIBELLE
      required: true
      comment: Nom de la personne

    - name: Prenom
      domain: DO_LIBELLE
      required: true
      comment: Prénom de la personne

    - name: Email
      domain: DO_LIBELLE
      comment: Adresse email

    - name: Telephone
      domain: DO_TELEPHONE
      comment: Numéro de téléphone

    - name: DateNaissance
      domain: DO_DATE_HEURE
      comment: Date de naissance

---
# Classe héritant de Personne
class:
  name: Employe
  extends: Personne
  trigram: EMP
  comment: Employé du restaurant

  properties:
    - name: Matricule
      domain: DO_CODE
      required: true
      comment: Matricule de l'employé

    - name: DateEmbauche
      domain: DO_DATE_HEURE
      required: true
      comment: Date d'embauche

    - name: Salaire
      domain: DO_PRIX
      comment: Salaire de l'employé

    - association: Restaurant
      role: Restaurant
      required: true
      withReverse: false
      comment: Restaurant où travaille l'employé

  unique:
    - [Matricule]

---
# Classe avec propriétés readonly et calculées
class:
  name: AvisClient
  trigram: AVI
  comment: Avis d'un client sur un restaurant

  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant de l'avis

    - name: Note
      domain: DO_QUANTITE
      required: true
      comment: Note sur 5

    - name: Commentaire
      domain: DO_LIBELLE
      comment: Commentaire de l'avis

    - name: DateAvis
      domain: DO_DATE_HEURE
      required: true
      comment: Date de l'avis

    - name: Approuve
      domain: DO_BOOLEEN
      required: true
      defaultValue: false
      comment: Indique si l'avis est approuvé par le restaurant

    - name: NombreVues
      domain: DO_QUANTITE
      required: true
      defaultValue: 0
      readonly: true
      comment: Nombre de vues de l'avis (calculé)

    - association: Client
      role: Client
      required: true
      withReverse: true
      comment: Client ayant donné l'avis

    - association: Restaurant
      role: Restaurant
      required: true
      withReverse: true
      comment: Restaurant concerné par l'avis

  unique:
    - [ClientIdClient, RestaurantIdRestaurant, DateAvis]

---
# Classe avec composition
class:
  name: Menu
  trigram: MEN
  comment: Menu du restaurant

  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant du menu

    - name: Nom
      domain: DO_LIBELLE
      required: true
      comment: Nom du menu

    - name: Description
      domain: DO_LIBELLE
      comment: Description du menu

    - name: Prix
      domain: DO_PRIX
      required: true
      comment: Prix du menu

    - name: Disponible
      domain: DO_BOOLEEN
      required: true
      defaultValue: true
      comment: Indique si le menu est disponible

    - name: DateDebut
      domain: DO_DATE_HEURE
      comment: Date de début de validité du menu

    - name: DateFin
      domain: DO_DATE_HEURE
      comment: Date de fin de validité du menu

    - association: Restaurant
      role: Restaurant
      required: true
      withReverse: true
      comment: Restaurant proposant ce menu

---
# Classe de composition pour Menu
class:
  name: MenuPlat
  trigram: MPL
  comment: Plat dans un menu

  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant de la relation

    - name: Ordre
      domain: DO_QUANTITE
      required: true
      comment: Ordre d'affichage du plat dans le menu

    - association: Menu
      role: Menu
      required: true
      withReverse: true
      comment: Menu contenant ce plat

    - association: Plat
      role: Plat
      required: true
      withReverse: true
      comment: Plat du menu

  unique:
    - [MenuIdMenu, Ordre]
    - [MenuIdMenu, PlatIdPlat]

---
# Classe avec association many-to-many implicite
class:
  name: Reservation
  trigram: REV
  comment: Réservation d'une table

  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant de la réservation

    - name: DateReservation
      domain: DO_DATE_HEURE
      required: true
      comment: Date et heure de la réservation

    - name: NombrePersonnes
      domain: DO_QUANTITE
      required: true
      comment: Nombre de personnes

    - name: Commentaire
      domain: DO_LIBELLE
      comment: Commentaire sur la réservation

    - name: Confirmee
      domain: DO_BOOLEEN
      required: true
      defaultValue: false
      comment: Indique si la réservation est confirmée

    - association: Client
      role: Client
      required: true
      withReverse: true
      comment: Client ayant fait la réservation

    - association: TableClient
      role: Table
      withReverse: true
      comment: Table réservée

    - association: Restaurant
      role: Restaurant
      required: true
      withReverse: true
      comment: Restaurant concerné par la réservation

  unique:
    - [TableClientIdTable, DateReservation]

---
# Classe avec propriétés personnalisées et valeurs par défaut
class:
  name: Promotion
  trigram: PRO
  comment: Promotion sur les plats

  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant de la promotion

    - name: Libelle
      domain: DO_LIBELLE
      required: true
      comment: Libellé de la promotion

    - name: PourcentageReduction
      domain: DO_QUANTITE
      required: true
      comment: Pourcentage de réduction (0-100)

    - name: DateDebut
      domain: DO_DATE_HEURE
      required: true
      comment: Date de début de la promotion

    - name: DateFin
      domain: DO_DATE_HEURE
      required: true
      comment: Date de fin de la promotion

    - name: Active
      domain: DO_BOOLEEN
      required: true
      defaultValue: true
      comment: Indique si la promotion est active

    - association: Restaurant
      role: Restaurant
      withReverse: true
      comment: Restaurant concerné par la promotion (null si globale)

---
# Classe avec association vers plusieurs plats (many-to-many)
class:
  name: PromotionPlat
  trigram: PPL
  comment: Association entre une promotion et un plat

  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant de l'association

    - association: Promotion
      role: Promotion
      required: true
      withReverse: true
      comment: Promotion concernée

    - association: Plat
      role: Plat
      required: true
      withReverse: true
      comment: Plat concerné par la promotion

  unique:
    - [PromotionIdPromotion, PlatIdPlat]
