---
module: Restaurant
tags:
  - back
uses:
  - meta/decorators
  - Restaurant/Entities/Restaurant

---
class:
  name: PersonneBase
  type: interface
  comment: Définition d'une personne
  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant de la personne

    - name: Nom
      domain: DO_LIBELLE
      required: true
      comment: Nom de la personne
      label: Nom

    - name: Prenom
      domain: DO_LIBELLE
      required: true
      comment: Prénom de la personne
      label: Prénom
---
class:
  name: Personne
  trigram: PER
  comment: Classe de base représentant une personne
  propertySourceOrder: [implements, properties, decorators]
  implements:
    - PersonneBase
  decorators:
    - DateCreation

  properties:
    - association: Departement
      defaultValue: 75
      useClass: false
      comment: Département de résidence de la personne.

  values:
    Jean: { Id: 1, Nom: Michel, Prenom: Jean, DateCreation: 2026-01-01T00:00:00Z }
---
class:
  name: EmployeBase
  type: interface
  extends: PersonneBase
  comment: Définition d'une personne
  properties:
    - name: Telephone
      domain: DO_TELEPHONE
      comment: Numéro de téléphone de l'employé.
---
class:
  name: Employe
  extends: Personne
  trigram: EMP
  comment: Employé du restaurant
  propertySourceOrder: [implements, properties]
  implements:
    - EmployeBase

  properties:
    - name: DateNaissance
      domain: DO_DATE_HEURE
      comment: Date de naissance

    - name: Matricule
      domain: DO_CODE
      required: true
      comment: Matricule de l'employé

    - name: DateEmbauche
      domain: DO_DATE_HEURE
      required: true
      comment: Date d'embauche

    - name: Salaire
      domain: DO_PRIX
      comment: Salaire de l'employé

    - association: Restaurant
      required: true
      withReverse: false
      comment: Restaurant où travaille l'employé

  indexes:
    - [Telephone]
    - properties: [Matricule]
      unique: true

  values:
    Michel: { Id: 2, Nom: Christophe, Prenom: Michel, Matricule: 123456, DateCreation: 2026-01-01T00:00:00Z, DateEmbauche: 2026-01-01T00:00:00Z, Restaurant: 1 }
---
class:
  name: Prestataire
  trigram: PST
  comment: Prestaire du restaurant
  implements:
    - EmployeBase

  properties: []
  indexes:
    - [Nom, Prenom]
    - [Telephone]
---
class:
  name: Client
  trigram: CLI
  extends: Personne
  comment: Client du restaurant

  properties:
    - name: Email
      domain: DO_LIBELLE
      comment: Adresse email du client
      label: Courriel
---
decorator:
  name: NombreVuesBase
  description: Décrit une classe de base technique qui gère le nombbre de vues.
  csharp:
    extends: NombreVuesBase
  java:
    extends: NombreVuesBase
    imports:
      - topmodel.test.NombreVuesBase
  properties:
    - name: NombreVues
      domain: DO_QUANTITE
      required: true
      defaultValue: 0
      readonly: true
      comment: Nombre de vues de l'avis (calculé)
      tags: []
---
class:
  name: AvisClient
  trigram: AVI
  comment: Avis d'un client sur un restaurant
  decorators:
    - DateCreation
    - NombreVuesBase

  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant de l'avis

    - name: Note
      domain: DO_QUANTITE
      required: true
      comment: Note sur 5

    - name: Commentaire
      domain: DO_LIBELLE
      comment: Commentaire de l'avis

    - name: DateAvis
      domain: DO_DATE_HEURE
      required: true
      comment: Date de l'avis

    - name: Approuve
      domain: DO_BOOLEEN
      required: true
      defaultValue: false
      comment: Indique si l'avis est approuvé par le restaurant

    - association: Client
      required: true
      withReverse: true
      comment: Client ayant donné l'avis

    - association: Restaurant
      required: true
      withReverse: true
      comment: Restaurant concerné par l'avis

  unique:
    - [Client, Restaurant, DateAvis]
