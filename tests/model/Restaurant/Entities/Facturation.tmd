---
uses:
  - Restaurant/Entities/External
  - Restaurant/Entities/Commande
module: Restaurant
tags:
  - back
---
class:
  name: Facture
  comment: Facture
  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant de la facture
    - association: Commande
      required: true
      comment: Commande associée à la facture
    - association: TypeFacture
      comment: type de facture
      property: Code
---
class:
  name: Paiement
  comment: Paiement
  properties:
    - association: Facture
      required: true
      comment: Facture associée au paiement
      primaryKey: true
    - association: SwileCard
      comment: Carte Swile utilisée pour le paiement
      primaryKey: true
      useClass: false
---
class:
  name: TypeFacture
  comment: Type de facture
  trigram: TFA
  readonly: true
  properties:
    - name: Code
      comment: Code du type de facture
      domain: DO_CODE
    - name: Libelle
      comment: Libellé du type de facture
      domain: DO_LIBELLE
  values:
    ELE: { Code: ELE, Libelle: Facture électronique }
    PHY: { Code: PHY, Libelle: Facture physique }
  unique:
    - [Code]
