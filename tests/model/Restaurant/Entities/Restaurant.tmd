---
module: Restaurant
tags:
  - back
uses:
  - meta/decorators
  - Restaurant/Entities/Menu
  - Restaurant/Entities/Personne

---
class:
  name: Lieu
  pluralName: Lieux
  type: abstract
  inheritanceStrategy: single-table
  trigram: LIE
  comment: Lieu

  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant du restaurant

    - name: Nom
      domain: DO_LIBELLE
      required: true
      comment: Nom du restaurant

    - name: Adresse
      domain: DO_LIBELLE
      comment: Adresse du restaurant
---
class:
  name: Restaurant
  trigram: RES
  comment: Restaurant
  extends: Lieu
  decorators:
    - DateCreation

  properties:
    - name: Telephone
      domain: DO_TELEPHONE
      comment: Numéro de téléphone

  values:
    BK: { Id: 1, Nom: Burger King, DateCreation: 1954-01-01T00:00:00Z }
---
class:
  name: Fournisseur
  trigram: FRN
  comment: Restaurant
  extends: Lieu

  properties:
    - name: Telephone
      domain: DO_TELEPHONE
      defaultValue: xx.xx.xx.xx.xx
      comment: Numéro de téléphone

    - name: Bio
      domain: DO_BOOLEEN
      comment: Si le fournisseur fait du bio.

  values:
    Pomona: { Id: 2, Nom: Pomona, Bio: true }
---
class:
  name: Table
  trigram: TAB
  comment: Table du restaurant
  decorators:
    - DateCreation

  properties:
    - name: Id
      domain: DO_ID
      primaryKey: true
      comment: Identifiant de la table

    - name: Numero
      domain: DO_CODE
      required: true
      comment: Numéro de la table

    - name: Capacite
      domain: DO_QUANTITE
      required: true
      comment: Capacité de la table (nombre de places)

    - name: Disponible
      domain: DO_BOOLEEN
      required: true
      defaultValue: true
      comment: Indique si la table est disponible

    - association: Restaurant
      required: true
      useClass: false
      withReverse:
        className: TableIds
      comment: Restaurant auquel appartient la table

  unique:
    - [RestaurantId, Numero]
---
class:
  name: Vaisselle
  type: abstract
  trigram: VSL
  inheritanceStrategy: distinct-tables
  comment: Vaisselle de restaurant
  properties:
    - name: Id
      domain: DO_SEQ_ID
      primaryKey: true
      comment: Id de la vaisselle
    - name: Description
      domain: DO_LIBELLE
      required: true
      comment: Description de la vaisselle.
---
class:
  name: Assiette
  extends: Vaisselle
  trigram: AST
  comment: Assiette.
  properties:
    - name: Taille
      required: true
      domain: DO_QUANTITE
      comment: Taille de l'assiette.
  values:
    Grande: { Id: 1, Description: Grande assiette, Taille: 29 }
---
class:
  name: Couvert
  extends: Vaisselle
  trigram: CVT
  comment: Couvert.
  properties: []
  values:
    Fourchette: { Id: 2, Description: Fourchette }
    Couteau: { Id: 3, Description: Couteau }
---
class:
  name: Verre
  extends: Vaisselle
  trigram: VRR
  comment: Verre.
  properties:
    - name: APied
      required: true
      domain: DO_BOOLEEN
      comment: Si le verre est à pied ou non.
