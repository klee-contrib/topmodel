---
module: Restaurant
tags:
  - back
  - front

---
class:
  name: StatutCommande
  trigram: STC
  reference: true
  comment: Statut d'une commande

  properties:
    - name: Code
      domain: DO_CODE
      primaryKey: true
      comment: Code du statut

    - name: Libelle
      domain: DO_LIBELLE
      required: true
      comment: Libellé du statut

  values:
    EnAttente: { Code: EN_ATT, Libelle: En attente }
    EnPreparation: { Code: EN_PREP, Libelle: En préparation }
    Prete: { Code: PRETE, Libelle: Prête }
    Servie: { Code: SERVIE, Libelle: Servie }
    Annulee: { Code: ANNULE, Libelle: Annulée }
---
class:
  name: CategoriePlat
  trigram: CAT
  reference: true
  comment: Catégorie de plat

  properties:
    - name: Code
      domain: DO_CODE
      primaryKey: true
      comment: Code de la catégorie

    - name: Libelle
      domain: DO_LIBELLE
      required: true
      comment: Libellé de la catégorie

  values:
    Entree: { Code: ENTREE, Libelle: Entrée }
    Plat: { Code: PLAT, Libelle: Plat principal }
    Dessert: { Code: DESSERT, Libelle: Dessert }
    Boisson: { Code: BOISSON, Libelle: Boisson }
