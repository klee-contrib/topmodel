---
module: Restaurant
tags:
  - back
  - front

---
class:
  name: StatutCommande
  trigram: STC
  reference: true
  enum: true
  comment: Statut d'une commande

  properties:
    - name: Code
      domain: DO_CODE
      primaryKey: true
      comment: Code du statut

    - name: Libelle
      domain: DO_LIBELLE
      required: true
      comment: Libellé du statut

  values:
    EnAttente: { Code: EN_ATT, Libelle: En attente }
    EnPreparation: { Code: EN_PREP, Libelle: En préparation }
    Prete: { Code: PRETE, Libelle: Prête }
    Servie: { Code: SERVIE, Libelle: Servie }
    Annulee: { Code: ANNULE, Libelle: Annulée }
---
class:
  name: CategoriePlat
  trigram: CAT
  reference: true
  enum: class
  comment: Catégorie de plat

  properties:
    - name: Code
      domain: DO_CODE
      primaryKey: true
      comment: Code de la catégorie

    - name: Libelle
      domain: DO_LIBELLE
      required: true
      comment: Libellé de la catégorie

    - name: Ordre
      domain: DO_QUANTITE
      required: true
      comment: Ordre d'affichage dans le menu.

  unique:
    - [Ordre]

  values:
    Entree: { Code: ENTREE, Libelle: Entrée, Ordre: 2 }
    Plat: { Code: PLAT, Libelle: Plat principal, Ordre: 3 }
    Dessert: { Code: DESSERT, Libelle: Dessert, Ordre: 4 }
    Boisson: { Code: BOISSON, Libelle: Boisson, Ordre: 1 }
---
class:
  name: Departement
  trigram: DEP
  reference: true
  comment: Département

  properties:
    - name: Code
      domain: DO_CODE
      primaryKey: true
      comment: Code du département.

    - name: Libelle
      domain: DO_LIBELLE
      required: true
      comment: Libellé du département.

  values:
    Paris: { Code: 75, Libelle: Paris }
    HautsDeSeine: { Code: 92, Libelle: Hauts de Seine }
    SeineSaintDenis: { Code: 93, Libelle: Seine Saint Denis }
    SeineEtMarne: { Code: 94, Libelle: Seine et Marne }
