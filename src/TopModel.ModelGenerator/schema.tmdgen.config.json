{
  "$id": "schema.tmdgen.config.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "tmdgen model generator configuration file",
  "additionalProperties": false,
  "definitions": {
    "domain": {
      "oneOf": [
        {
          "type": "object",
          "description": "Mapping between a property name and a model in the target model",
          "additionalProperties": false,
          "required": ["domain", "name"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Property name or property-name regular expression to match"
            },
            "domain": {
              "type": "string",
              "description": "Target domain matching the name"
            },
            "scale": {
              "type": "number",
              "description": "Domain scale"
            },
            "precision": {
              "type": "number",
              "description": "Domain precision"
            }
          }
        },
        {
          "type": "object",
          "description": "Mapping between a data type and a model in the target model",
          "additionalProperties": false,
          "required": ["type", "domain"],
          "properties": {
            "type": {
              "type": "string",
              "description": "Property type or property-type regular expression to match"
            },
            "domain": {
              "type": "string",
              "description": "Target domain matching the type"
            },
            "scale": {
              "type": "number",
              "description": "Domain scale"
            },
            "precision": {
              "type": "number",
              "description": "Domain precision"
            }
          }
        }
      ]
    }
  },
  "properties": {
    "modelRoot": {
      "type": "string",
      "description": "Model generation directory path relative to the target model root directory"
    },
    "lockFileName": {
      "type": "string",
      "description": "Lock file name",
      "default": "tmdgen.lock"
    },
    "language": {
      "type": "string",
      "description": "Language of technical labels written in generated content. This setting is independent of the console message language (which always matches the OS language)."
    },
    "noWarn": {
      "type": "array",
      "description": "List of warnings to ignore.",
      "items": {
        "type": "string",
        "description": "Warning code (TMDXXXX) to ignore",
        "enum": ["TMD1004", "TMD1005"]
      }
    },
    "ignoredFiles": {
      "type": "array",
      "description": "Files to ignore after the first generation (relative to the configuration file).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "comment"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Path of the file to ignore, relative to the configuration file."
          },
          "comment": {
            "type": "string",
            "description": "Reason."
          }
        }
      }
    },
    "database": {
      "type": "array",
      "description": "Configurations for generating TopModel files from a database",
      "items": {
        "type": "object",
        "description": "Configuration for generating TopModel files from a database",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "tags": {
            "type": "array",
            "description": "Tags to add to generated files",
            "items": {
              "type": "string",
              "description": "Tag to add to generated files"
            }
          },
          "classNameOverrides": {
            "type": "object",
            "description": "Override for generated class names. Does not affect the class's SQL name.",
            "additionalProperties": {
              "type": "string",
              "description": "Override to use."
            }
          },
          "modules": {
            "type": "array",
            "description": "Modules and the classes they must contain",
            "items": {
              "type": "object",
              "description": "Module containing classes",
              "additionalProperties": false,
              "required": ["name", "classes"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Module name"
                },
                "classes": {
                  "type": "array",
                  "description": "PascalCase names of classes that must belong to the module",
                  "items": {
                    "type": "string",
                    "description": "Name of a class that must belong to the module"
                  }
                },
                "tags": {
                  "type": "array",
                  "description": "Additional tags to add to this module's classes.",
                  "items": {
                    "type": "string",
                    "description": "Tag name."
                  }
                }
              }
            }
          },
          "domains": {
            "type": "array",
            "description": "Mappings between types defined in the OpenAPI specification and domains in the target model",
            "items": {
              "$ref": "#/definitions/domain"
            }
          },
          "outputDirectory": {
            "type": "string",
            "description": "Folder where generated files and modules must be placed. This path is relative to modelRoot"
          },
          "exclude": {
            "type": "array",
            "description": "Tables to exclude from generation",
            "items": {
              "type": "string",
              "description": "Table to exclude from generation"
            }
          },
          "extractValues": {
            "type": "array",
            "description": "Classes whose values must be extracted",
            "items": {
              "type": "string",
              "description": "Class whose values must be extracted"
            }
          },
          "source": {
            "type": "object",
            "description": "Database connection information",
            "additionalProperties": false,
            "required": ["dbType"],
            "properties": {
              "host": {
                "type": "string",
                "description": "Host",
                "default": "localhost"
              },
              "port": {
                "type": "string",
                "description": "Port number",
                "default": "5432"
              },
              "dbName": {
                "type": "string",
                "description": "Database name",
                "default": "postgres"
              },
              "schema": {
                "type": "string",
                "description": "Schema name",
                "default": "public"
              },
              "user": {
                "type": "string",
                "description": "Database connection user",
                "default": "postgres"
              },
              "password": {
                "type": "string",
                "description": "Database connection password",
                "default": "postgres"
              },
              "dbType": {
                "type": "string",
                "description": "Database type: postgresql, oracle, mySql, msSql",
                "enum": ["oracle", "postgresql", "mySql", "msSql"]
              }
            }
          }
        }
      }
    },
    "openApi": {
      "type": "array",
      "description": "Configurations for generating TopModel files from OpenAPI files",
      "items": {
        "type": "object",
        "description": "Configuration for generating TopModel files from an OpenAPI file",
        "additionalProperties": false,
        "properties": {
          "domains": {
            "type": "array",
            "description": "Mappings between types defined in the OpenAPI specification and domains in the target model",
            "items": {
              "$ref": "#/definitions/domain"
            }
          },
          "source": {
            "type": "string",
            "description": "URL or relative path of the OpenAPI JSON or YAML specification file"
          },
          "outputDirectory": {
            "type": "string",
            "description": "Folder where generated files and modules must be placed. This path is relative to modelRoot and supports templating with `{module}`.",
            "default": "{module}"
          },
          "module": {
            "type": "string",
            "description": "Module for generated model files. Default: `module`."
          },
          "modelTags": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Tag to place in the generated model file"
            }
          },
          "endpointTags": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Tag to place in the generated endpoint file"
            }
          },
          "include": {
            "type": "array",
            "description": "Specification tags that must be generated in the target model",
            "items": {
              "type": "string",
              "description": "Specification tag to generate in the target model"
            }
          },
          "modelFileName": {
            "type": "string",
            "description": "Name of the file in which the model will be declared"
          },
          "preservePropertyCasing": {
            "type": "boolean",
            "description": "Preserves generated property names for generation through `modgen` instead of converting them to the target language's format. Default: `true`."
          },
          "classPrefix": {
            "type": "string",
            "description": "Prefix to add to all classes generated for this source."
          },
          "useEnumClasses": {
            "type": "boolean",
            "description": "Generates `enum: class` classes instead of `enum: true` classes for enums."
          }
        }
      }
    }
  }
}
