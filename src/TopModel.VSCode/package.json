{
    "name": "topmodel",
    "displayName": "TopModel",
    "version": "4.7.1",
    "description": "Extension for TopModel",
    "categories": [
        "Programming Languages"
    ],
    "license": "MIT",
    "contributors": [
        {
            "name": "gideruette"
        },
        {
            "name": "Jabx"
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/klee-contrib/topmodel",
        "directory": "TopModel.VSCode"
    },
    "publisher": "JabX",
    "type": "module",
    "main": "./out/main.js",
    "scripts": {
        "build": "npm run build-extension && npm run build-preview-assets",
        "build-extension": "rolldown ./src/extension.ts --file out/main.js --external vscode --format esm --platform node --no-codeSplitting",
        "build-preview-assets": "rolldown ./src/topmodel-preview.ts --file out/topmodel-preview.js --platform browser --format iife --minify --no-codeSplitting",
        "extension-watch": "npm run build-extension -- --sourcemap --watch",
        "lint": "oxlint src",
        "package": "vsce package",
        "postinstall": "node postinstall.mjs",
        "preview-watch": "rolldown ./src/topmodel-preview.ts --file out/topmodel-preview.js --platform browser --format iife --watch --no-codeSplitting",
        "start": "concurrently --kill-others \"npm run preview-watch\" \"npm run extension-watch\"",
        "vscode:prepublish": "npm run build"
    },
    "dependencies": {
        "es-toolkit": "1.53.2",
        "js-yaml": "5.5.0",
        "mermaid": "12.3.0",
        "mobx": "7.1.7",
        "open": "11.0.4",
        "vscode-languageclient": "11.0.1"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "@types/vscode": "1.146.0",
        "@vscode/vsce": "4.1.1",
        "concurrently": "10.0.7",
        "glob": "14.0.6",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "rolldown": "1.3.3",
        "typescript": "7.0.2"
    },
    "contributes": {
        "iconThemes": [
            {
                "id": "topModel",
                "label": "TopModel",
                "path": "./icon-theme.json"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "topmodel.preview",
                    "group": "navigation",
                    "when": "resourceExtname==.tmd"
                }
            ]
        },
        "commands": [
            {
                "command": "topmodel.modgen.install",
                "title": "Install TopModel.Generator",
                "category": "TopModel.Generator"
            },
            {
                "command": "topmodel.tmdgen.install",
                "title": "Install TopModel.ModelGenerator",
                "category": "TopModel.ModelGenerator"
            },
            {
                "command": "topmodel.modls.install",
                "title": "Install TopModel.LanguageServer",
                "category": "TopModel.LanguageServer"
            },
            {
                "command": "topmodel.modgen.update",
                "title": "Update TopModel.Generator",
                "category": "TopModel.Generator"
            },
            {
                "command": "topmodel.modls.update",
                "title": "Update TopModel.LanguageServer",
                "category": "TopModel.LanguageServer"
            },
            {
                "command": "topmodel.modls.restart",
                "title": "Restart Language Server",
                "category": "TopModel.LanguageServer"
            },
            {
                "command": "topmodel.modgen",
                "title": "Run Model Generation",
                "category": "TopModel.Generator"
            },
            {
                "command": "topmodel.modgen.watch",
                "title": "Run Model Generation (Watch Mode)",
                "category": "TopModel.Generator"
            },
            {
                "command": "topmodel.releaseNote",
                "title": "Open Release Notes",
                "category": "TopModel"
            },
            {
                "command": "topmodel.preview",
                "title": "Open UML Preview of the Model",
                "category": "TopModel.Generator",
                "icon": {
                    "light": "Preview.svg",
                    "dark": "Preview_inverse.svg"
                }
            }
        ],
        "languages": [
            {
                "id": "yaml",
                "extensions": [
                    "tmd"
                ],
                "filenamePatterns": [
                    "topmodel*.config",
                    "tmdgen*.config"
                ]
            }
        ],
        "walkthroughs": [
            {
                "id": "topmodel.configuration",
                "title": "TopModel Configuration",
                "description": "Step-by-step TopModel Configuration Guide",
                "steps": [
                    {
                        "id": "install.dotnet",
                        "title": "Install .NET",
                        "media": {
                            "markdown": "dotnet.md"
                        }
                    }
                ]
            }
        ],
        "customEditors": [
            {
                "viewType": "topmodel.preview",
                "displayName": "TopModel: Preview",
                "selector": [
                    {
                        "filenamePattern": "*.tmd"
                    }
                ],
                "priority": "option"
            }
        ],
        "configuration": {
            "title": "TopModel",
            "properties": {
                "topmodel.autoUpdate": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically updates TopModel"
                },
                "topmodel.languageServerPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Path to the language server executable to launch, instead of the globally installed `modls` tool. Useful to debug a local build of the language server, or to use another version than the one installed globally. Accepts `${workspaceFolder}` and relative paths (resolved from the workspace folder). A `.dll` is launched with `dotnet`. When set, the extension no longer installs or updates the `TopModel.LanguageServer` tool."
                }
            }
        }
    },
    "activationEvents": [
        "workspaceContains:**/topmodel*.config"
    ],
    "extensionDependencies": [
        "redhat.vscode-yaml"
    ],
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.146.0"
    }
}
