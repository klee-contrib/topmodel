#### ATTENTION CE FICHIER EST GENERE AUTOMATIQUEMENT !
####

---
module: Petstore
tags:
  - petstore
uses:
  - Petstore/Model
---
endpoint:
  name: DeleteOrder
  method: DELETE
  route: store/order/{orderId}
  description: "Delete purchase order by ID"
  preservePropertyCasing: true
  params:
    - name: orderId
      domain: DO_ID
      comment: ID of the order that needs to be deleted
---
endpoint:
  name: GetInventory
  method: GET
  route: store/inventory
  description: "Returns pet inventories by status"
  preservePropertyCasing: true
  returns:
    composition: GetGetInventoryResponse
    name: Result
    required: false
    comment: successful operation
---
endpoint:
  name: GetOrderById
  method: GET
  route: store/order/{orderId}
  description: "Find purchase order by ID"
  preservePropertyCasing: true
  params:
    - name: orderId
      domain: DO_ID
      comment: ID of order that needs to be fetched
  returns:
    composition: Order
    name: Result
    required: false
    comment: successful operation
---
endpoint:
  name: PlaceOrder
  method: POST
  route: store/order
  description: "Place an order for a pet"
  preservePropertyCasing: true
  params:
    - composition: Order
      name: body
      required: false
      comment: Non documenté
  returns:
    composition: Order
    name: Result
    required: false
    comment: successful operation
