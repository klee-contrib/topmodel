# yaml-language-server: $schema=./topmodel.config.schema.json
---
app: topmodel.jpa.sample.demo
modelRoot: ../../model
generators:
  - ../../../TopModel.Generator.Jpa
i18n:
  rootPath: "{lang}"
jpa:
  - name: origin
    tags:
      - back
      - api-client
    tagVariables:
      back:
        apiPath: "javagen:{app:path}/api/server/{module:path}"
        apiGeneration: Server
      api-client:
        apiPath: "javagen:{app:path}/api/client/{module:path}"
        apiGeneration: Client
    outputDirectory: src/main
    daosPath: "javagen:{app:path}/daos/{module:path}"
    apiPath: "{apiPath}"
    apiGeneration: "{apiGeneration}"
    resourcesPath: resources/i18n/model
    fieldsEnum:
      - persisted
      - non-persisted
    persistenceMode: jakarta
    daosInterface: topmodel.jpa.sample.demo.daos.repository.CustomCrudRepository
    daosAbstract: false
    mappersInClass: true
    useJdbc: false
    enumsAsEnums: false
    openApiAnnotations: false