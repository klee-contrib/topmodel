---
module: Common
tags: []

---
annotation:
  name: Email
  description: Email
  target:
    - property
  java:
    - text: "@Email"
      when:
        - class-property
        - non-persisted
      imports:
        - jakarta.validation.constraints.Email
---
domain:
  name: DO_BOOLEEN
  label: boolean
  ts:
    type: boolean
  csharp:
    type: bool
  java:
    type: Boolean
  sql:
    type: boolean
---
domain:
  name: DO_CODE
  label: Code
  length: 10
  asDomains:
    list: DO_CODE_LISTE
  ts:
    type: string
  csharp:
    type: string
  java:
    type: String
  sql:
    type: varchar
---
domain:
  name: DO_CODE_LISTE
  label: Code
  length: 10
  ts:
    type: string[]
    genericType: "{T}[]"
  csharp:
    type: string[]
    genericType: "{T}[]"
  java:
    type: List<String>
    genericType: List<{T}>
    imports:
      - java.util.List
  sql:
    type: varchar
---
domain:
  name: DO_DATE
  label: Date
  ts:
    type: string
  csharp:
    type: DateOnly
  java:
    type: LocalDate
    imports:
      - java.time.LocalDate
  sql:
    type: date
---
domain:
  name: DO_DATE_HEURE
  label: Date
  ts:
    type: string
    values:
      overrides:
        now:
          value: today().toISO()
          imports:
            - "./common/utils/today"
  csharp:
    type: DateTime
    values:
      overrides:
        now: DateTime.UtcNow
  java:
    type: LocalDateTime
    imports:
      - java.time.LocalDateTime
    values:
      overrides:
        now: LocalDateTime.now()
  sql:
    type: date
    values:
      overrides:
        now: now()
---
domain:
  name: DO_EMAIL
  label: Email
  annotations:
    - Email
  ts:
    type: string
  csharp:
    type: string
  java:
    type: String
  sql:
    type: varchar
  length: 50
---
domain:
  name: DO_ENTIER
  label: Entier
  ts:
    type: number
  csharp:
    type: long
  java:
    type: Long
  sql:
    type: bigint
---
domain:
  name: DO_ID
  label: ID technique
  autoGeneratedValue: true
  asDomains:
    list: DO_ID_LISTE
  ts:
    type: number
  csharp:
    type: int
  java:
    type: Integer
  sql:
    type: int
---
domain:
  name: DO_ID_LISTE
  label: Liste d'ids
  ts:
    type: number[]
    genericType: "{T}[]"
  csharp:
    type: int[]
    genericType: "{T}[]"
  java:
    type: List<Integer>
    genericType: List<{T}>
    imports:
      - java.util.List
  sql:
    type: int
---
domain:
  name: DO_LIBELLE
  label: Libellé
  length: 100
  ts:
    type: string
  csharp:
    type: string
  java:
    type: String
  sql:
    type: varchar
---
domain:
  name: DO_LISTE
  label: Liste pour composition
  csharp:
    genericType: ICollection<{T}>
  java:
    genericType: List<{T}>
    imports:
      - java.util.List
  ts:
    genericType: "{T}[]"
  sql: {}

---
domain:
  name: FILE_FORM
  mediaType: "multipart/form-data"
  label: Fichier
  bodyParam: true
  ts:
    type: File
  java:
    type: MultipartFile
    imports:
      - "org.springframework.web.multipart.MultipartFile"
  csharp:
    type: IFormFile
  sql:
    type: bytea
---
domain:
  name: RESOURCE
  label: Resource
  bodyParam: true
  ts:
    type: Blob
  java:
    type: Resource
    imports:
      - "org.springframework.core.io.Resource"
  sql:
    type: text[]
  csharp:
    type: IFormFile
