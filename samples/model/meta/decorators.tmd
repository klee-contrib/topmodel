---
module: Common
tags:
  - entity

---
annotation:
  name: EntityListeners
  description: Annotation pour EntityListeners.
  java:
    - text: EntityListeners(AuditingEntityListener.class)
      imports:
        - org.springframework.data.jpa.domain.support.AuditingEntityListener
        - jakarta.persistence.EntityListeners
---
annotation:
  name: Security
  description: Annotation pour Security.
  parameters:
    - name: permission
      required: true
      comment: Permission demandée
  java:
    - text: PreAuthorize("{permission}")
      imports:
        - org.springframework.security.access.prepost.PreAuthorize
---
decorator:
  name: EntityListeners
  description: Date création
  annotations:
    - EntityListeners

  properties:
    - name: DateCreation
      label: Date de création
      required: true
      defaultValue: now
      domain: DO_DATE_CREATION
      comment: Date de création de l'utilisateur.

    - name: DateModification
      label: Date de modification
      defaultValue: now
      domain: DO_DATE_MODIFICATION
      comment: Date de modification de l'utilisateur.
---
decorator:
  name: Security
  description: Ajoute une annotation de sécurité sur un endpoint.
  parameters:
    - name: permission
      required: true
      comment: Permission demandée
  annotations:
    - Security:
        permission: "{permission}"
