---
module: Securite.Profil
tags:
  - back
uses:
  - meta/decorators
  - Securite/Profil/01_References
  - Securite/Utilisateur/02_Entities

---
class:
  name: Profil
  trigram: PRO
  label: Profil
  comment: Profil des utilisateurs
  decorators:
    - EntityListeners

  properties:
    - name: Id
      label: Id technique du profil
      primaryKey: true
      domain: DO_ID
      comment: Id technique

    - name: Libelle
      label: Libellé du profil
      domain: DO_LIBELLE
      required: true
      comment: Libellé du profil.

  mappers:
    to:
      - class: Profil
        mappings:
          Id: false
          DateCreation: false
          DateModification: false
          Utilisateurs: false
---
class:
  name: ProfilDroit
  trigram: PRD
  comment: Association N-N Profils <> Droits

  properties:
    - association: Profil
      primaryKey: true
      withReverse:
        comment: Liste des droits du profil.
      comment: Profil.

    - association: Droit
      primaryKey: true
      comment: Droit.
