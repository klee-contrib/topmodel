<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>4.6.0</Version>
    <Description>Language Server TopModel.</Description>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>modls</ToolCommandName>
    <ResourceLanguages>en</ResourceLanguages>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OmniSharp.Extensions.LanguageServer" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TopModel.Core\TopModel.Core.csproj" />
    <ProjectReference Include="..\TopModel.Utils.Cli\TopModel.Utils.Cli.csproj" />
    <ProjectReference Include="..\TopModel.Utils.Mermaid\TopModel.Utils.Mermaid.csproj" />
  </ItemGroup>
  <Target Name="KillLanguageServerBeforeBuild" BeforeTargets="BeforeBuild">
    <Exec
      Condition="'$(OS)' == 'Windows_NT'"
      Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-CimInstance Win32_Process -Filter 'Name = ''dotnet.exe''' -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -like '*TopModel.LanguageServer*' } | ForEach-Object { taskkill /PID $_.ProcessId /F &gt; $null 2&gt;&amp;1 }; exit 0&quot;"
    />
    <Exec
      Condition="'$(OS)' != 'Windows_NT'"
      Command="sh -c &quot;pkill -f 'dotnet .*TopModel.LanguageServer\.dll' || true&quot;"
    />
  </Target>
  <Target Name="PostPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)/System.Reactive.xml" />
  </Target>
</Project>
